---
import { SITE } from '../site';
import { SITE_ICON as SiteIcon } from '../data/icons';
// collapse: 360px 未満では 4 項目のナビと並ばないため、文字を読み上げ専用にしてアイコンだけ見せる。
interface Props { href?: string; iconSize?: number; collapse?: boolean }
const { href, iconSize = 22, collapse = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class="display text-xl leading-8 flex shrink-0 items-center gap-2">
  <SiteIcon size={iconSize} stroke-width={2.5} class="shrink-0 text-accent" aria-hidden="true" />
  <span class:list={['whitespace-nowrap', collapse && 'max-[22.5rem]:sr-only']}>{SITE.name}<span class="text-accent">.</span></span>
</Tag>
