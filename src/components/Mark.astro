---
// 作品名から決定的に生成する小さな紋章。画像を用意しなくても Works に顔が付く。
interface Props { seed: string; size?: number; class?: string }
const { seed, size = 56, class: cls } = Astro.props;
let h = 2166136261;
for (const ch of seed) { h ^= ch.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; }
const bits: boolean[][] = [];
for (let y = 0; y < 5; y++) {
  const row: boolean[] = [];
  for (let x = 0; x < 3; x++) { row.push(((h >>> (y * 3 + x)) & 1) === 1); }
  bits.push([...row, row[1], row[0]]); // 左右対称
}
const cell = 100 / 5;
---
<svg viewBox="0 0 100 100" width={size} height={size} class={cls} aria-hidden="true">
  <rect width="100" height="100" fill="var(--paper-2)" />
  {bits.flatMap((row, y) => row.map((on, x) => on
    ? <rect x={x * cell + 1} y={y * cell + 1} width={cell - 2} height={cell - 2} fill="var(--accent)" />
    : null))}
</svg>
