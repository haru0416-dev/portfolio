---
import { ICONS, type IconName } from '../data/icons';
interface Props { icon: string; size?: number; class?: string }
const { icon, size = 48, class: cls } = Astro.props;
const Icon = ICONS[icon as IconName] ?? ICONS.box;
---
<span class:list={['tile inline-flex items-center justify-center bg-paper text-accent shrink-0', cls]} style={`--tile:${size}px`}>
  <Icon size={size / 2} stroke-width={2.25} aria-hidden="true" />
</span>
