---
// 角丸の座布団に lucide のアイコンを 1 つ載せる。Works の顔として使う。
import { ICONS, type IconName } from '../data/icons';
interface Props { icon: IconName; size?: number; class?: string }
const { icon, size = 48, class: cls } = Astro.props;
const Icon = ICONS[icon] ?? ICONS.box;
---
<span class:list={['inline-flex items-center justify-center rounded-xl bg-paper text-accent shrink-0', cls]} style={`width:${size}px;height:${size}px`}>
  <Icon size={Math.round(size * 0.5)} stroke-width={2.25} aria-hidden="true" />
</span>
