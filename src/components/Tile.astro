---
// 角丸の座布団に lucide のアイコンを 1 つ載せる。大きさは 8px の倍数
import { ICONS, type IconName } from '../data/icons';
interface Props { icon: IconName; size?: number; class?: string }
const { icon, size = 48, class: cls } = Astro.props;
const Icon = ICONS[icon] ?? ICONS.box;
---
<span class:list={['tile inline-flex items-center justify-center bg-paper text-accent shrink-0', cls]} style={`width:${size}px;height:${size}px;border-radius:${size / 3}px`}>
  <Icon size={size / 2} stroke-width={2.25} aria-hidden="true" />
</span>
