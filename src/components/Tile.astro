---
// 角丸の座布団に lucide のアイコンを 1 つ載せる。Works の顔として使う。
import { ICONS, type IconName } from '../data/icons';
interface Props { icon: IconName; size?: number; class?: string; 'class:list'?: unknown }
const { icon, size = 48, class: cls, 'class:list': clsList } = Astro.props;
const Icon = ICONS[icon] ?? ICONS.box;
---
<span class:list={['tile inline-flex items-center justify-center rounded-xl bg-paper text-accent shrink-0', cls, clsList]} style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.28)}px`}>
  <Icon size={Math.round(size * 0.46)} stroke-width={2.25} aria-hidden="true" />
</span>
