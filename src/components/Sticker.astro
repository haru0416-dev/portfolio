---
import type { SITE_ICON } from '../data/icons';
interface Props {
  icon: typeof SITE_ICON;
  /** 省略すると親の大きさいっぱいに描く。 */
  size?: number;
  /** ホバーで持ち上げる。カードの中では親が動くので付けない。 */
  lift?: boolean;
  class?: string;
}
const { icon: Icon, size, lift = false, class: cls } = Astro.props;
const dims = size ? { width: size, height: size } : {};
---
{/* 下の 1 枚は太い線と塗りで、型抜きしたシールの台紙になる。 */}
<span class:list={['sticker', !size && 'sticker-fill', lift && 'sticker-lift', cls]} aria-hidden="true">
  <Icon {...dims} class="sticker-base" stroke-width={7} fill="currentColor" />
  <Icon {...dims} class="sticker-ink" stroke-width={2} />
</span>
