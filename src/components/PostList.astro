---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { readingMinutes } from '../scripts/reading';
interface Props { posts: CollectionEntry<'blog'>[]; compact?: boolean }
const { posts, compact = false } = Astro.props;
---
<ol role="list">
  {posts.map((p) => (
    <li class="reveal" data-tags={p.data.tags.join(' ')}>
      <a href={`/blog/${p.id}/`} class="group grid grid-cols-[6rem_1fr] gap-x-4 py-4">
        <div class="text-xs text-muted pt-1">
          <FormattedDate date={p.data.pubDate} class="block leading-4" />
          {!compact && <span class="block leading-4 mt-1">{readingMinutes(p.body)} min</span>}
        </div>
        <div class="min-w-0">
          <h3 transition:name={`post-${p.id}`} class="display-jp text-lg w-fit group-hover:text-accent transition-colors">{p.data.title}</h3>
          {p.data.description && <p class="text-sm text-ink-2 mt-1">{p.data.description}</p>}
          {!compact && p.data.tags.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-2">{p.data.tags.map((t) => <span class="tag">#{t}</span>)}</div>
          )}
        </div>
      </a>
    </li>
  ))}
</ol>
