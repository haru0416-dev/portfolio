---
// トップの「顔」。Flow Field を丸く切って、数百フレーム描いたら止まる。クリックで描き直す。
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<canvas id="flow-mark" class:list={['flow-mark aspect-square w-full rounded-full cursor-pointer', cls]} title="クリックで描き直す"></canvas>
<script>
  import { startFlow } from '../scripts/flow';
  startFlow(document.getElementById('flow-mark') as HTMLCanvasElement, {
    particles: 700, scale: 0.006, step: 1.4, frames: 420, alpha: 0.45, circle: true, speed: 4,
  });
</script>
