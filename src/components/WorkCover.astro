---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ICONS, type IconName } from '../data/icons';
interface Props {
  name: string;
  icon: IconName;
  cover?: ImageMetadata;
  hue: number;
  iconSize?: number;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
}
const { name, icon, cover, hue, iconSize = 96, sizes = '(min-width: 64rem) 20rem, (min-width: 40rem) 50vw, 100vw', widths = [480, 800, 1200], loading = 'lazy' } = Astro.props;
const Icon = ICONS[icon];
if (!Icon) throw new Error(`未登録のアイコン: ${icon}`);
---
<span transition:name={`work-cover-${name}`} class:list={['cover', `hue-${hue % 3}`]} aria-hidden="true">
  {cover
    ? <Image src={cover} alt="" widths={widths} sizes={sizes} loading={loading} class="cover-img" />
    : <Icon size={iconSize} stroke-width={1.75} class="cover-icon" />}
</span>
