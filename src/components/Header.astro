---
import Logo from './Logo.astro';
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/works/', label: 'Works' },
  { href: '/lab/', label: 'Lab' },
];
const path = Astro.url.pathname;
---
<header transition:name="header" transition:animate="none" class="site glass sticky top-0 z-10 line-bottom rounded-none">
  <div class="max-w-site mx-auto px-4 sm:px-8 h-16 flex items-center justify-between gap-2 max-[23.625rem]:gap-1 sm:gap-4">
    {/* ロゴの文字が出て 4 項目と並ぶと 378px 要る。それより狭い間は、隙間を詰めて右の余白に収める。 */}
    <Logo href="/" collapse />
    <nav aria-label="メイン" class="flex shrink-0 items-center gap-1 max-[23.625rem]:gap-0.5 sm:gap-2 text-xs tracking-[.04em] min-[25rem]:tracking-[.08em] uppercase">
      {nav.some((n) => path.startsWith(n.href)) && <span class="nav-current" aria-hidden="true"></span>}
      {nav.map((n, i) => {
        const current = path.startsWith(n.href);
        return (
          <a
            href={n.href}
            aria-current={current ? 'page' : undefined}
            style={`view-transition-name: nav-link-${i}`}
            class:list={['nav-link inline-flex shrink-0 items-center h-8 rounded-lg px-1 max-[23.625rem]:px-0.5 sm:px-3 whitespace-nowrap transition-colors font-bold', current ? 'text-ink' : 'text-muted hover:text-ink hover:bg-paper-2']}
          >{n.label}</a>
        );
      })}
      <button id="theme-settings" type="button" commandfor="theme-options" command="toggle-popover" aria-label="テーマを選ぶ" aria-expanded="false" aria-controls="theme-options" class="press inline-flex shrink-0 items-center justify-center w-8 h-8 rounded-lg text-muted hover:text-ink hover:bg-paper-2">
        <Sun size={16} stroke-width={2} aria-hidden="true" class="when-light" />
        <Moon size={16} stroke-width={2} aria-hidden="true" class="when-dark" />
      </button>
    </nav>
  </div>
</header>
<div id="theme-options" popover="auto" class="theme-options">
  <fieldset>
    <legend class="mb-2 text-sm font-bold">テーマ</legend>
    <label>
      <input type="radio" name="site-theme" value="system" checked />
      <span>端末の設定に合わせる</span>
    </label>
    <label>
      <input type="radio" name="site-theme" value="light" />
      <span>ライト</span>
    </label>
    <label>
      <input type="radio" name="site-theme" value="dark" />
      <span>ダーク</span>
    </label>
  </fieldset>
</div>
<style>
  .theme-options {
    position: fixed;
    inset: calc(4.5rem - var(--header-shrink, 0px)) max(1rem, env(safe-area-inset-right), calc((100vw - var(--container-site)) / 2 + 2rem)) auto auto;
    margin: 0;
    width: 16rem;
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 5.5rem);
    overflow-y: auto;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 8px 24px var(--glass-lo);
    transform-origin: top right;
    /* 開くときはスクリプト(motion)のばねで出す。閉じるときは popover がすぐ消えるので、CSS で少しだけ残して薄くする。 */
    transition: opacity 120ms ease-in, translate 120ms ease-in, display 120ms allow-discrete, overlay 120ms allow-discrete;
  }
  .theme-options:not(:popover-open) { opacity: 0; translate: 0 -4px; }
  /* 開いた最初のコマから透明にしておき、スクリプトのばねが始まる前に一瞬全部見えるのを防ぐ。 */
  @starting-style { .theme-options:popover-open { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .theme-options:not(:popover-open) { translate: none; } }
  /* 今いるページの面。リンクの外に置き、アンカーで今のリンクに重ねる。ページを移ると View Transition が前のページの面から滑らせる(global.css)。
     リンクにも遷移名を付けるのは、遷移の間も文字を面の上に描くため。名前の付いた要素は文書の順に重なるので、面を先に置く。 */
  nav { position: relative; isolation: isolate; }
  .nav-link { view-transition-class: nav-link; }
  .nav-link[aria-current="page"] { anchor-name: --nav-current; }
  .nav-current {
    position: absolute; z-index: -1; border-radius: .5rem; background: var(--paper-2); pointer-events: none;
    position-anchor: --nav-current; top: anchor(top); left: anchor(left); width: anchor-size(width); height: anchor-size(height);
    view-transition-name: nav-current;
  }
  @supports not (anchor-name: --a) {
    .nav-current { display: none; }
    .nav-link[aria-current="page"] { background: var(--paper-2); }
  }
  .theme-options fieldset { min-width: 0; }
  .theme-options label {
    display: flex;
    align-items: center;
    gap: .5rem;
    min-height: 2.5rem;
    padding: .5rem;
    border-radius: .5rem;
    font-size: var(--text-sm);
    line-height: 1.5rem;
  }
  .theme-options label:has(> input:checked) { background: var(--paper-2); }
  .theme-options label:has(> input:focus-visible) { outline: 3px solid var(--ink); outline-offset: 0; }
  .theme-options input { flex-shrink: 0; accent-color: var(--accent-ink); cursor: inherit; }
  /* 枠は行(label)に描くので、ラジオ自体の枠は重ねない。 */
  .theme-options input:focus-visible { outline: none; }
</style>
<script>
  import { animate } from 'motion';
  import { isDark, onThemeChange } from '../scripts/theme';
  import { SPRING, reduced } from '../scripts/motion';
  let cleanup: (() => void) | undefined;
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = undefined;
    const btn = document.getElementById('theme-settings');
    const popover = document.getElementById('theme-options');
    if (!(btn instanceof HTMLButtonElement) || !popover) return;
    if (!('commandForElement' in HTMLButtonElement.prototype)) {
      btn.removeAttribute('commandfor');
      btn.removeAttribute('command');
      btn.setAttribute('popovertarget', popover.id);
    }
    const choices = popover.querySelectorAll<HTMLInputElement>('input[name="site-theme"]');
    const sync = () => {
      const saved = localStorage.getItem('theme');
      const mode = saved === 'light' || saved === 'dark' ? saved : 'system';
      choices.forEach((choice) => { choice.checked = choice.value === mode; });
      const effective = isDark() ? 'ダーク' : 'ライト';
      const label = mode === 'system' ? `端末の設定に合わせる、現在は${effective}` : effective;
      btn.setAttribute('aria-label', `テーマを選ぶ（${label}）`);
    };
    const select = (event: Event) => {
      const choice = event.target;
      if (!(choice instanceof HTMLInputElement) || !choice.checked) return;
      const next = choice.value;
      if (next !== 'system' && next !== 'light' && next !== 'dark') return;
      const apply = () => {
        if (next === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
        applySiteTheme?.();
        sync();
      };
      // 見た目のテーマが変わるときだけ、水面が上下する切り替えにする。
      const toDark = next === 'system' ? matchMedia('(prefers-color-scheme: dark)').matches : next === 'dark';
      if (toDark === isDark() || !document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        apply();
        return;
      }
      const root = document.documentElement;
      root.dataset.themeSwitch = toDark ? 'dark' : 'light';
      // 水面の縁の光は新しい画面にだけ置き、波と同時に動かし始める。
      const tide = document.createElement('div');
      tide.className = 'theme-tide';
      tide.setAttribute('aria-hidden', 'true');
      const transition = document.startViewTransition(() => { document.body.append(tide); apply(); });
      transition.ready.then(() => tide.classList.add('is-moving'), () => {});
      transition.finished.finally(() => { tide.remove(); delete root.dataset.themeSwitch; });
    };
    let openedByKey = false;
    let opening: ReturnType<typeof animate> | undefined;
    // Enter で押したときも、.press の縮み(motion の press)が作り物の pointerdown を出す。本物の操作だけを数える。
    const markPointer = (e: PointerEvent) => { if (e.isTrusted) openedByKey = false; };
    const markKey = () => { openedByKey = true; };
    const syncOpen = () => {
      const open = popover.matches(':popover-open');
      btn.setAttribute('aria-expanded', String(open));
      // マウスで開いたときはキーボード用の枠を出さない。
      if (open) popover.querySelector<HTMLInputElement>('input:checked')?.focus({ focusVisible: openedByKey } as FocusOptions);
      // 開くときはばねで出し、終わったら手で書いた値を外す。閉じるときは途中でも止めて外し、CSS の遷移に任せる。
      opening?.stop();
      popover.style.opacity = ''; popover.style.transform = '';
      if (!open) return;
      opening = reduced()
        ? animate(popover, { opacity: [0, 1] }, { duration: 0.15 })
        : animate(popover, { opacity: [0, 1], y: [-8, 0], scale: [0.96, 1] }, { ...SPRING.enter, visualDuration: 0.3, opacity: { duration: 0.15 } });
      const mine = opening;
      mine.then(() => { if (opening !== mine) return; opening = undefined; popover.style.opacity = ''; popover.style.transform = ''; });
    };
    sync();
    btn.addEventListener('pointerdown', markPointer);
    btn.addEventListener('keydown', markKey);
    popover.addEventListener('change', select);
    popover.addEventListener('toggle', syncOpen);
    const offTheme = onThemeChange(sync);
    cleanup = () => {
      offTheme();
      popover.removeEventListener('change', select);
      popover.removeEventListener('toggle', syncOpen);
      btn.removeEventListener('pointerdown', markPointer);
      btn.removeEventListener('keydown', markKey);
    };
  });
</script>
