---
import { SITE } from '../site';
const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/works', label: 'Works' },
  { href: '/lab', label: 'Lab' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-10 bg-paper/85 backdrop-blur border-b border-line">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
    <a href="/" class="serif text-2xl leading-none">{SITE.name}<span class="text-accent">.</span></a>
    <nav class="flex items-center gap-6 sm:gap-8 text-[13px] tracking-[.12em] uppercase">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['u-link transition-colors', path.startsWith(n.href) ? 'text-ink' : 'text-muted hover:text-ink']}
        >{n.label}</a>
      ))}
      <button id="theme-toggle" type="button" aria-label="テーマ切替" class="text-muted hover:text-ink transition-colors -mr-1">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/></svg>
      </button>
    </nav>
  </div>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
