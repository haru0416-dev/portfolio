---
import { SITE } from '../site';
import { SITE_ICON as SiteIcon } from '../data/icons';
const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/works', label: 'Works' },
  { href: '/lab', label: 'Lab' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-10 bg-paper/85 backdrop-blur border-b border-line">
  <div class="max-w-[64rem] mx-auto px-4 sm:px-8 h-16 flex items-center justify-between gap-4">
    <a href="/" class="serif text-xl leading-8 flex items-center gap-2"><SiteIcon size={22} stroke-width={2.5} class="text-accent" aria-hidden="true" /><span>{SITE.name}<span class="text-accent">.</span></span></a>
    <nav class="flex items-center gap-1 sm:gap-2 text-xs tracking-[.08em] uppercase">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['inline-flex items-center h-8 rounded-full px-3 transition-colors font-bold', path.startsWith(n.href) ? 'bg-paper-2 text-ink' : 'text-muted hover:text-ink hover:bg-paper-2']}
        >{n.label}</a>
      ))}
      <button id="theme-toggle" type="button" aria-label="テーマ切替" class="press inline-flex items-center justify-center w-8 h-8 rounded-full text-muted hover:text-ink transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"/></svg>
      </button>
    </nav>
  </div>
</header>
<script>
  // ページ遷移のたびに新しいボタンへ付け直す
  document.addEventListener('astro:page-load', () => {
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });
  });
</script>
