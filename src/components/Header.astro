---
import { SITE } from '../site';
const nav = [
  { href: '/blog', label: 'Blog' },
  { href: '/works', label: 'Works' },
  { href: '/lab', label: 'Lab' },
];
const path = Astro.url.pathname;
---
<header class="border-b border-line">
  <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between gap-6">
    <a href="/" class="font-semibold tracking-tight">{SITE.name}</a>
    <nav class="flex items-center gap-5 text-sm">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['hover:text-accent transition-colors', path.startsWith(n.href) ? 'text-accent' : 'text-muted']}
        >{n.label}</a>
      ))}
      <button id="theme-toggle" type="button" aria-label="テーマ切替" class="text-muted hover:text-fg transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9c0-.5 0-1-.1-1.4A5.5 5.5 0 0 1 12.4 3.1C12.3 3 12.1 3 12 3z"/></svg>
      </button>
    </nav>
  </div>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
