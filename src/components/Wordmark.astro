---
// 名前を 1 文字ずつ順に出す。読み込み時に一度だけ見る演出なので許容範囲。
interface Props { text: string; class?: string }
const { text, class: cls } = Astro.props;
const chars = [...text];
---
<span class:list={['wordmark', cls]} aria-label={text}>
  {chars.map((c, i) => <span class="wm-char" style={`--i:${i}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}
</span>
