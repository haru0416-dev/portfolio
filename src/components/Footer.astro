---
import { SITE } from '../site';
---
<footer class="border-t border-line">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-10 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
    <div>
      <div class="serif text-2xl">{SITE.name}<span class="text-accent">.</span></div>
      <p class="text-xs text-muted mt-2">© {new Date().getFullYear()} {SITE.name}. Built with Astro.</p>
    </div>
    <nav class="flex gap-6 text-[12px] tracking-[.12em] uppercase text-muted">
      <a href={SITE.github} class="u-link hover:text-ink">GitHub</a>
      <a href="/rss.xml" class="u-link hover:text-ink">RSS</a>
    </nav>
  </div>
</footer>
