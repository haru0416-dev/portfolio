---
// 名刺の裏。座標は mm。
// 光も陰も白や灰色で描かず、その場所の水の色を明るく・暗くした色で描く。そうしないと水の上に貼ったように浮く。
import { CARD, INK, marineSnow, causticCells } from '../../data/card';
import { SITE } from '../../site';

interface Props {
  id: string;
  /** 3D の札は網の影だけを傾きに合わせて動かすため、under(水)・shadow(網の影)・over(その上すべて)に分けて重ねる。 */
  layer: 'under' | 'shadow' | 'over';
}
const { id, layer } = Astro.props;
const { width: W, height: H, bleed: B, safe: S } = CARD;
const host = 'haru0416.dev';

type Point = [number, number];
const bleedBox = { x: -B, y: -B, w: W + B * 2, h: H + B * 2 };
const f = (n: number) => n.toFixed(2);
const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
/** 深さ。太陽のある左上で 0、右下の角で 1。 */
const depth = ([x, y]: Point) => clamp01(Math.hypot(x, y) / Math.hypot(W, H));
/** 影を落とす向き。太陽の反対(右下)へ。3D の札の網の影は business-card.ts が同じ 0.45mm だけずらす。 */
const SHADOW_OFFSET: Point = [0.45, 0.45];
/** 名前とドメインのまわり。主役の光の筋と粒を通さない。 */
const TEXT_BOX = { x0: 8, x1: 47, y0: 38, y1: 60 };
const inText = ([x, y]: Point) => x > TEXT_BOX.x0 && x < TEXT_BOX.x1 && y > TEXT_BOX.y0 && y < TEXT_BOX.y1;

/** 水滴の波紋。R は一番外の輪の半径、n は輪の数。 */
const DROPS = [
  { x: 40.5, y: 73, R: 8.6, n: 6 },
  { x: 12.5, y: 20, R: 4.8, n: 4 },
];

// 網の目を深いほど大きく、波の進む向きに引き伸ばす。どちらも広げる向きの写像なので、裁ち落としの範囲は網で覆われたまま。
const WAVE = (-28 * Math.PI) / 180;
const flow = ([x, y]: Point): Point => {
  const g = 1 + 0.28 * depth([x, y]);
  const px = x * g, py = y * g;
  const cx = W / 2, cy = H / 2, dx = px - cx, dy = py - cy;
  const u = dx * Math.cos(WAVE) + dy * Math.sin(WAVE), v = -dx * Math.sin(WAVE) + dy * Math.cos(WAVE);
  const su = u * 1.28;
  return [cx + su * Math.cos(WAVE) - v * Math.sin(WAVE), cy + su * Math.sin(WAVE) + v * Math.cos(WAVE)];
};
// 頂点の移動は場所だけで決まる関数にする。隣り合うセルが共有する頂点が同じだけ動き、網が途切れない。
const sway = ([x, y]: Point): Point => [
  x + 0.55 * Math.sin(0.42 * y + 0.9) + 0.35 * Math.sin(0.23 * (x + y) + 2.1),
  y + 0.55 * Math.sin(0.38 * x + 1.7) + 0.35 * Math.sin(0.27 * (x - y) + 0.4),
];
const bend = (p: Point): Point => {
  let [x, y] = p;
  for (const d of DROPS) {
    const reach = d.R * 1.3, dx = x - d.x, dy = y - d.y, r = Math.hypot(dx, dy);
    if (r === 0 || r > reach) continue;
    const push = 0.9 * (1 - r / reach) * Math.sin((r / 2.4) * Math.PI * 2);
    x += (dx / r) * push; y += (dy / r) * push;
  }
  return [x, y];
};
const shape = (c: Point[]) => c.map(flow).map(sway).map(bend);
const centroid = (poly: Point[]): Point => [poly.reduce((a, p) => a + p[0], 0) / poly.length, poly.reduce((a, p) => a + p[1], 0) / poly.length];
const area = (poly: Point[]) => Math.abs(poly.reduce((a, p, i) => { const q = poly[(i + 1) % poly.length]; return a + p[0] * q[1] - q[0] * p[1]; }, 0)) / 2;
const shrink = (poly: Point[], k: number): Point[] => {
  const [cx, cy] = centroid(poly);
  return poly.map(([x, y]) => [cx + (x - cx) * k, cy + (y - cy) * k]);
};
const mid = (a: Point, b: Point): Point => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
/** 角を、辺の中点をつなぐ 2 次ベジェで丸める。頂点の数だけの曲線で済み、紙面が重くならない。 */
const smooth = (poly: Point[]) => {
  const start = mid(poly.at(-1)!, poly[0]);
  return `M${f(start[0])} ${f(start[1])}` + poly.map((p, i) => {
    const m = mid(p, poly[(i + 1) % poly.length]);
    return `Q${f(p[0])} ${f(p[1])} ${f(m[0])} ${f(m[1])}`;
  }).join('') + 'Z';
};

const coarse = causticCells(31, bleedBox, 7, 1).map(shape);
const fine = causticCells(53, bleedBox, 12, 1).map(shape);
const glow = [0.99, 0.955, 0.91];

const areas = coarse.map(area);
const aMin = Math.min(...areas), aMax = Math.max(...areas);
const filaments = coarse.map((c, i) => {
  const loose = (areas[i] - aMin) / (aMax - aMin), d = depth(centroid(c));
  return { d: smooth(c), width: (0.12 + 0.15 * loose) * (1 + 1.1 * d), opacity: (0.7 - 0.3 * loose) * (1 - 0.5 * d) };
});

// 共有する頂点は同じ位置に動くので、座標の文字列でまとめられる。
const keyOf = (p: Point) => `${p[0].toFixed(3)},${p[1].toFixed(3)}`;
const pos = new Map<string, Point>();
const links = new Map<string, Set<string>>();
for (const c of coarse) c.forEach((p, i) => {
  const a = keyOf(p), b = keyOf(c[(i + 1) % c.length]);
  pos.set(a, p);
  if (!links.has(a)) links.set(a, new Set());
  if (!links.has(b)) links.set(b, new Set());
  links.get(a)!.add(b); links.get(b)!.add(a);
});
const junctions = [...links.entries()].filter(([, n]) => n.size >= 3).map(([k]) => pos.get(k)!).map((p) => ({ p, d: depth(p) }));

// 主役の光の筋。交点から曲がりの少ない辺をたどる。網の丸めた角と同じ式で描くので、網からずれない。
const rand = (() => { let s = 7; return () => ((s = (s * 16807) % 2147483647) / 2147483647); })();
const heroStarts = junctions.filter(({ p, d }) => d < 0.8 && !inText(p) && p[0] > 0 && p[0] < W && p[1] > 0 && p[1] < H)
  .map((j) => ({ ...j, w: (1 - j.d) * rand() }))
  .sort((a, b) => b.w - a.w).slice(0, 7);
const heroes = heroStarts.map(({ p }) => {
  const path: Point[] = [p];
  let prev: string | null = null, cur = keyOf(p);
  for (let step = 0; step < 6; step++) {
    const here = pos.get(cur)!, from = prev ? pos.get(prev)! : null;
    const options = [...links.get(cur)!].filter((k) => k !== prev).map((k) => {
      const q = pos.get(k)!;
      const turn = from ? Math.abs(Math.atan2(q[1] - here[1], q[0] - here[0]) - Math.atan2(here[1] - from[1], here[0] - from[0])) : rand();
      return { k, q, turn: Math.min(turn, Math.PI * 2 - turn) };
    }).filter(({ q }) => !inText(q)).sort((a, b) => a.turn - b.turn);
    if (!options.length) break;
    prev = cur; cur = options[0].k; path.push(options[0].q);
  }
  if (path.length < 3) return null;
  const d = depth(centroid(path));
  let dStr = `M${f(mid(path[0], path[1])[0])} ${f(mid(path[0], path[1])[1])}`;
  for (let i = 1; i < path.length - 1; i++) { const m = mid(path[i], path[i + 1]); dStr += `Q${f(path[i][0])} ${f(path[i][1])} ${f(m[0])} ${f(m[1])}`; }
  return { d: dStr, depth: d };
}).filter((h): h is { d: string; depth: number } => h !== null);

const cusps = coarse.flatMap((c, i) => {
  if ((i * 2654435761) % 97 > 26) return [];
  const v = c[(i * 7) % c.length], [cx, cy] = centroid(c), d = depth(v);
  const tip: Point = [v[0] + (cx - v[0]) * 0.42, v[1] + (cy - v[1]) * 0.42];
  const len = Math.hypot(tip[0] - v[0], tip[1] - v[1]), nx = -(tip[1] - v[1]) / len, ny = (tip[0] - v[0]) / len;
  const w = 0.16 * (1 + d), bow = len * 0.18;
  const ctrl: Point = [(v[0] + tip[0]) / 2 + nx * bow, (v[1] + tip[1]) / 2 + ny * bow];
  return [{
    d: `M${f(v[0] + nx * w)} ${f(v[1] + ny * w)}Q${f(ctrl[0])} ${f(ctrl[1])} ${f(tip[0])} ${f(tip[1])}Q${f(ctrl[0] - nx * w * 0.6)} ${f(ctrl[1] - ny * w * 0.6)} ${f(v[0] - nx * w)} ${f(v[1] - ny * w)}Z`,
    opacity: 0.5 * (1 - 0.5 * d),
  }];
});

// 波紋。浅い水では短い波ほど速く進むため、外側ほど輪が詰まる。
const ripples = DROPS.flatMap((drop) => Array.from({ length: drop.n }, (_, k) => {
  const t = (k + 1) / drop.n, r = drop.R * Math.sqrt(t), d = depth([drop.x, drop.y]);
  const soft = 1 + 0.8 * d, fade = (1 - 0.6 * t) * (1 - 0.3 * d);
  const band = (0.62 - 0.42 * t) * soft, rim = (0.22 - 0.13 * t) * soft;
  return { x: drop.x, y: drop.y, r, band, rim, fade };
}));

const motes = marineSnow(41, 46).filter((p) => !inText([p.x, p.y]));
---
<defs>
  <linearGradient id={`${id}-water`} x1="0" y1="0" x2={W * 0.8} y2={H} gradientUnits="userSpaceOnUse">
    <stop offset="0" stop-color={INK.shallowSand} /><stop offset=".48" stop-color={INK.shallowAqua} /><stop offset="1" stop-color={INK.deepTeal} />
  </linearGradient>
  <linearGradient id={`${id}-filament`} x1="0" y1="0" x2={W} y2={H} gradientUnits="userSpaceOnUse">
    <stop offset="0" stop-color={INK.filamentWarm} /><stop offset="1" stop-color={INK.filamentCool} />
  </linearGradient>
  <radialGradient id={`${id}-node`}>
    <stop offset="0" stop-color={INK.filamentWarm} stop-opacity=".95" /><stop offset="1" stop-color={INK.filamentWarm} stop-opacity="0" />
  </radialGradient>
  <radialGradient id={`${id}-sun`} cx="4" cy="-6" r="62" gradientUnits="userSpaceOnUse">
    <stop offset="0" stop-color="#ffffff" stop-opacity=".9" />
    <stop offset=".05" stop-color="#ffffff" stop-opacity=".75" />
    <stop offset=".13" stop-color={INK.sunGlow} stop-opacity=".55" />
    <stop offset=".45" stop-color={INK.sunHaze} stop-opacity=".18" />
    <stop offset="1" stop-color={INK.sunHaze} stop-opacity="0" />
  </radialGradient>
  <linearGradient id={`${id}-crest`} x1="0" y1="0" x2="1" y2="1">
    <stop offset=".1" stop-color={INK.filamentWarm} stop-opacity=".95" />
    <stop offset=".9" stop-color={INK.filamentCool} stop-opacity=".35" />
  </linearGradient>
  <linearGradient id={`${id}-sink`} x1="0" y1="30" x2={W * 0.3} y2={H + B} gradientUnits="userSpaceOnUse">
    <stop offset="0" stop-color={INK.deepTeal} stop-opacity="0" />
    <stop offset="1" stop-color={INK.deepTeal} stop-opacity=".6" />
  </linearGradient>
</defs>

{layer === 'under' && <rect x={-B} y={-B} width={W + B * 2} height={H + B * 2} fill={`url(#${id}-water)`} />}

{layer === 'shadow' && (
  <g fill="none" stroke={INK.waterShade} opacity=".13">
    {filaments.map((l) => <path d={l.d} stroke-width={f(l.width)} />)}
  </g>
)}

{layer === 'over' && (
  <>
    <g fill="none" stroke={`url(#${id}-filament)`}>
      {filaments.map((l) => <path d={l.d} stroke-width={f(l.width)} opacity={f(l.opacity)} />)}
    </g>
    <g fill={`url(#${id}-filament)`}>{cusps.map((c) => <path d={c.d} opacity={f(c.opacity)} />)}</g>
    {glow.map((k) => (
      <g fill={INK.waterShade} opacity=".045">{coarse.map((c) => <path d={smooth(shrink(c, k))} />)}</g>
    ))}
    {[0.95, 0.85].map((k) => (
      <g fill={INK.waterShade} opacity=".025">{fine.map((c) => <path d={smooth(shrink(c, k))} />)}</g>
    ))}
    <g fill="none" stroke-linecap="round" stroke-linejoin="round">
      {heroes.map((h) => <path d={h.d} stroke={INK.sunGlow} stroke-width={f(1.1 * (1 + 0.6 * h.depth))} opacity={f(0.22 * (1 - 0.5 * h.depth))} />)}
      {heroes.map((h) => <path d={h.d} stroke={`url(#${id}-filament)`} stroke-width={f(0.3 * (1 + 0.6 * h.depth))} opacity={f(0.95 * (1 - 0.4 * h.depth))} />)}
    </g>
    {junctions.map(({ p, d }) => <circle cx={f(p[0])} cy={f(p[1])} r={f(0.42 * (1 + 0.7 * d))} fill={`url(#${id}-node)`} opacity={f(0.7 * (1 - 0.5 * d))} />)}

    {ripples.map((q) => (
      <g fill="none" opacity={f(q.fade)}>
        <circle cx={f(q.x + SHADOW_OFFSET[0] * 0.5)} cy={f(q.y + SHADOW_OFFSET[1] * 0.5)} r={f(Math.max(q.r - q.band / 2 - q.rim / 2, 0.2))} stroke={INK.waterShade} stroke-width={f(q.band)} opacity=".16" />
        <circle cx={f(q.x)} cy={f(q.y)} r={f(q.r)} stroke={`url(#${id}-crest)`} stroke-width={f(q.rim)} />
      </g>
    ))}

    <g fill={INK.mote}>{motes.map((p) => <circle cx={p.x} cy={p.y} r={p.r * 0.8} opacity={p.a * 0.4} />)}</g>

    {/* 霞と太陽の光は水の中にあるもの全部の上にかけ、その上に紙に刷った文字だけを載せる。 */}
    <rect x={-B} y={-B} width={W + B * 2} height={H + B * 2} fill={`url(#${id}-sink)`} />
    <rect x={-B} y={-B} width={W + B * 2} height={H + B * 2} fill={`url(#${id}-sun)`} />

    <g text-anchor="middle">
      <text x={W / 2} y={50} class="t-name t-name-back" fill={INK.lightInk}>{SITE.name}<tspan fill={INK.accent}>.</tspan></text>
      <text x={W / 2} y={57} class="t-mono" fill={INK.lightInk2}>{host}</text>
      <text x={W / 2} y={H - S - 0.6} class="t-eyebrow" fill={INK.lightInk2}>NOTES &amp; EXPERIMENTS</text>
    </g>
  </>
)}
