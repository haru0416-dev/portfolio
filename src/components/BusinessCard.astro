---
import CardArt from './card/CardArt.astro';
import { CARD } from '../data/card';
---
<div class="bc-scene" style={`--card-w:${CARD.width};--card-h:${CARD.height};--card-r:${CARD.radius};--card-t:${CARD.thickness}`}>
  {/* 表と裏を重ねた 1 枚の札を、上に重ねた透明なボタンで操作する。 */}
  <div class="bc-stage" data-business-card>
    <div class="bc-shadow bc-shadow-near" aria-hidden="true"><i></i></div>
    <div class="bc-shadow bc-shadow-far" aria-hidden="true"><i></i></div>
    <div class="bc-card">
      <div class="bc-face bc-front" data-face="front">
        <CardArt side="front" id="bc-front" />
        <span class="bc-paper" aria-hidden="true"></span>
        <span class="bc-light" aria-hidden="true"></span>
      </div>
      <div class="bc-face bc-back" data-face="back" aria-hidden="true">
        {/* 裏は水・網の影・その上すべての 3 層。網の影だけを JS が傾きに合わせて動かし、水の厚みを出す。 */}
        <CardArt side="back" id="bc-back-under" layer="under" />
        <span class="bc-net-shadow" aria-hidden="true"><CardArt side="back" id="bc-back-shadow" layer="shadow" /></span>
        <CardArt side="back" id="bc-back-over" layer="over" />
        <span class="bc-paper" aria-hidden="true"></span>
        <span class="bc-light" aria-hidden="true"></span>
      </div>
      {/* 紙の断ち。表と裏の間に、札と同じ形の紙の板を厚みの向きに重ねる。傾けると板の輪郭がずれて見え、角の丸みにも沿った断面になる。
          刷った色は表面だけなので、断面は紙の白が見える。 */}
      {[-1, 0, 1].map((k) => <span class="bc-core" style={`--k:${k}`} aria-hidden="true"></span>)}
      {/* 真横では板が厚みのない線になって消えるため、そのときだけ左右の断ちを帯で見せる。 */}
      <span class="bc-edge bc-edge-l" aria-hidden="true"></span>
      <span class="bc-edge bc-edge-r" aria-hidden="true"></span>
    </div>
    <button type="button" class="bc-hit" aria-pressed="false" aria-label="名刺を裏返す"></button>
  </div>
</div>

<script>
  import { startBusinessCard } from '../scripts/business-card';
  document.addEventListener('astro:page-load', () => {
    const stops = [...document.querySelectorAll<HTMLElement>('[data-business-card]')].map(startBusinessCard);
    if (stops.length) document.addEventListener('astro:before-swap', () => stops.forEach((stop) => stop()), { once: true });
  });
</script>

<style>
  /* 1mm の画面上の長さ。名刺の幅を 16rem にそろえる。上下は、持ち上げたときの影が切れない幅を空ける。
     左右は、斜めに置いて張り出す角のぶんだけ空け、角を見出しの端にそろえる。 */
  .bc-scene {
    --mm: calc(16rem / var(--card-w)); --tilt-angle: -4deg;
    display: grid; place-items: center;
    padding: 2rem calc(var(--card-h) * var(--mm) / 2 * sin(abs(var(--tilt-angle))) - var(--card-w) * var(--mm) / 2 * (1 - cos(var(--tilt-angle)))) 3rem;
  }

  .bc-stage {
    position: relative; width: calc(var(--card-w) * var(--mm)); aspect-ratio: 55 / 91;
    /* 机に置いたように少し斜めにする。回す向きは JS が札の縦横に直す。 */
    perspective: 1400px; rotate: var(--tilt-angle);
    /* 長押しで札の文字が選択されたり、iOS のメニューが出たりしないようにする。札は手で持つ物として扱う。 */
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  /* 札・影・光・断ちの transform と opacity は JS が毎フレーム直接書く。ここにあるのは止まっているときの形。 */
  .bc-card {
    position: relative; width: 100%; height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .bc-face {
    position: absolute; inset: 0; overflow: hidden;
    border-radius: calc(var(--card-r) * var(--mm));
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    background: #1b2032;
    /* 面は一度描いた画像のまま動かす。回すたびに描き直すと、文字が毎回少し違う位置に描かれてぶれて見える。 */
    will-change: transform;
  }
  .bc-face > :global(.card-art), .bc-net-shadow { position: absolute; inset: 0; }
  .bc-net-shadow { will-change: transform; }
  .bc-front { transform: translateZ(calc(var(--card-t) * var(--mm) / 2)); }
  /* 裏は明るい浅い海なので、面の下地も明るくし、縁のにじみに暗い色が出ないようにする。 */
  .bc-back { transform: rotateY(180deg) translateZ(calc(var(--card-t) * var(--mm) / 2)); background: #eef2f6; }

  /* 板は厚みの中に等間隔で置く。正面から見たとき表の縁のにじみから白が透けないよう、輪郭より少し内側に寄せる。 */
  .bc-core {
    position: absolute; inset: .6px; pointer-events: none;
    border-radius: calc(var(--card-r) * var(--mm) - .6px);
    background: oklch(86% 0.01 285);
    transform: translateZ(calc(var(--k) * var(--card-t) * var(--mm) / 3));
  }
  /* 帯は斜めから見ると縁がぎざつくため、真横に近いときだけ JS が --edge-on で出す。角の丸みにかからない長さにする。 */
  .bc-edge {
    position: absolute; pointer-events: none; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    top: calc(var(--card-r) * var(--mm)); bottom: calc(var(--card-r) * var(--mm)); left: 50%;
    width: calc(var(--card-t) * var(--mm)); margin-left: calc(var(--card-t) * var(--mm) / -2);
    background: oklch(86% 0.01 285); opacity: 0;
  }
  .bc-edge-l { transform: rotateY(-90deg) translateZ(calc(var(--card-w) * var(--mm) / 2)); }
  .bc-edge-r { transform: rotateY(90deg) translateZ(calc(var(--card-w) * var(--mm) / 2)); }

  /* 紙の粒。背景と同じ粒を重ね、名刺がサイトと同じ質感に見えるようにする。
     札を斜めに置くと、粒の画像が回転の補間でならされ、振れ幅が 6 割ほどに減る。同じ粒を 2 枚重ねて(約 1.9 倍)0.94 をかけ、背景と同じ強さに戻す。 */
  .bc-paper { position: absolute; inset: 0; pointer-events: none; background: var(--grain), var(--grain); opacity: .94; }
  /* 光。マットコートは広くぼんやり光り、光から遠い縁は沈む。
     札より大きい板の中心にグラデーションを描き、JS が板ごと動かして縮尺を変える。半径は札の対角線の半分を基準にする。
     光の点は中心から縦横 4 割まで動き、縮尺は 1 以上なので、板は札の 1.8 倍あれば札を覆い切る。大きくすると合成の手間が面積のぶん増える。 */
  .bc-light {
    --reach: calc(sqrt(var(--card-w) * var(--card-w) + var(--card-h) * var(--card-h)) / 2 * var(--mm));
    position: absolute; left: -40%; top: -40%; width: 180%; height: 180%; pointer-events: none;
    background:
      radial-gradient(circle var(--reach) at 50% 50%, oklch(100% 0 0 / 16%), transparent 50%),
      radial-gradient(circle var(--reach) at 50% 50%, transparent 45%, oklch(0% 0 0 / 28%));
    opacity: .25; will-change: transform, opacity;
  }
  /* 明るい裏では、光から遠い縁の沈みを弱める。暗い表と同じ強さだと、水の色が濁って見える。 */
  .bc-back .bc-light {
    background:
      radial-gradient(circle var(--reach) at 50% 50%, oklch(100% 0 0 / 22%), transparent 50%),
      radial-gradient(circle var(--reach) at 50% 50%, transparent 50%, oklch(30% 0.05 250 / 12%));
  }

  /* 影はぼかしの弱い 1 枚と強い 1 枚。JS が不透明度の配分を変えて、持ち上げたときのぼけを表す。
     ぼかしは動かない内側の要素にかけ、外側だけを動かす。ぼかしは最初に一度だけ描かれ、毎フレームかけ直さない。
     半径は JS の BLUR_NEAR・BLUR_FAR と同じ値にする。 */
  .bc-shadow {
    position: absolute; inset: 3% 4% 0; pointer-events: none;
    transform: translate(4px, 12px); will-change: transform, opacity;
  }
  .bc-shadow i {
    position: absolute; inset: 0; border-radius: calc(var(--card-r) * var(--mm));
    background: light-dark(oklch(25% 0.05 var(--h) / 45%), oklch(5% 0.02 var(--h) / 75%));
  }
  .bc-shadow-near { opacity: .8; }
  .bc-shadow-near i { filter: blur(10px); }
  .bc-shadow-far { opacity: 0; }
  .bc-shadow-far i { filter: blur(24px); }

  .bc-hit {
    position: absolute; inset: 0; border-radius: calc(var(--card-r) * var(--mm)); background: transparent;
    /* 縦のスクロールは妨げず、横の指の動きだけ札を回すのに使う。 */
    touch-action: pan-y; -webkit-tap-highlight-color: transparent;
  }

  /* 動きを減らす設定では回さず、面を差し替える。 */
  @media (prefers-reduced-motion: reduce) {
    .bc-card { transform: none; }
    .bc-face { transition: opacity 200ms ease; }
    .bc-front { transform: none; }
    .bc-back { transform: none; opacity: 0; }
    .bc-stage.is-back .bc-back { opacity: 1; }
    .bc-stage.is-back .bc-front { opacity: 0; }
    .bc-core, .bc-edge { display: none; }
  }
</style>
