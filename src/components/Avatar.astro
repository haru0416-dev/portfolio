---
import { Image } from 'astro:assets';
import haru from '../assets/avatar/haru.png';
interface Props {
  /** 表示する大きさ(img の sizes)。枠の大きさに合わせる。 */
  sizes: string;
  class?: string;
}
const { sizes, class: cls } = Astro.props;
---
{/* 台紙は画像内。操作は avatar-play.ts に任せる。トップは画面幅で出し分ける 2 枚を置くので、遅延読み込みにして
    隠れている方を読み込ませない(eager だと display: none でも読み込まれる)。見えている方はすぐ読み込まれる。 */}
<span class:list={['sticker-hit', cls]} style={`--art-ratio: ${haru.width} / ${haru.height}`} aria-hidden="true">
  <span class="sticker sticker-fill sticker-art sticker-lift">
    <Image src={haru} alt="" widths={[128, 256, 384, 640]} sizes={sizes} loading="lazy" draggable="false" />
  </span>
</span>

<script>
  import { startAvatarPlay } from '../scripts/avatar-play';
  document.addEventListener('astro:page-load', () => {
    const stops = [...document.querySelectorAll<HTMLElement>('.sticker-hit')].map(startAvatarPlay);
    if (stops.length) document.addEventListener('astro:before-swap', () => stops.forEach((stop) => stop()), { once: true });
  });
</script>
