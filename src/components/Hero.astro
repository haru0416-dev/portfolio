---
import Wordmark from './Wordmark.astro';
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<header class="pt-4 pb-12 mb-4">
  <h1 class="display text-5xl sm:text-7xl tracking-[-0.01em]"><Wordmark text={title} /></h1>
  {lead && <p class="text-base text-ink-2 mt-4 max-w-[36rem] hero-lead">{lead}</p>}
</header>
