---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { labFromPath } from '../data/lab';
import { RAYS } from '../data/sea';
import { rootColorStyle, THEME_COLOR } from '../palette';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  image?: { src: string; alt: string };
  type?: 'website' | 'article';
  jpHeadings?: boolean;
  /** 等幅のフォントを使うページ。先読みしないと、遅い回線でコードなどが後から差し替わる。 */
  mono?: boolean;
}
const { title, description = SITE.description, wide = false, image, type = 'website', jpHeadings = true, mono = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const lab = labFromPath(Astro.url.pathname);
const social = image ?? (lab ? { src: `/og/lab/${lab.slug}.png`, alt: `実験「${lab.title}」の題名と haru0416.dev` } : undefined);
const socialImage = new URL(social?.src ?? '/og.png', Astro.site);
const socialImageAlt = social?.alt ?? `haru のロゴと「${SITE.description}」、haru0416.dev`;
---
<!doctype html>
<html lang="ja" style={rootColorStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" data-light={THEME_COLOR.light} data-dark={THEME_COLOR.dark} />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" data-light={THEME_COLOR.light} data-dark={THEME_COLOR.dark} />
    <script is:inline>
      // 初回描画より先に実行し、保存済みテーマとのちらつきを防ぐ。
      (() => {
        const apply = () => {
          const t = localStorage.getItem('theme');
          const h = document.documentElement;
          h.classList.toggle('dark', t === 'dark');
          h.classList.toggle('light', t === 'light');
          const scheme = document.querySelector('meta[name="color-scheme"]');
          if (scheme) scheme.content = t === 'light' || t === 'dark' ? t : 'light dark';
          document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
            m.content = t === 'light' || t === 'dark' ? m.dataset[t] : m.media.includes('dark') ? m.dataset.dark : m.dataset.light;
          });
        };
        globalThis.applySiteTheme = apply;
        apply();
        if (!globalThis.__themeSwapBound) {
          globalThis.__themeSwapBound = true;
          document.addEventListener('astro:after-swap', () => globalThis.applySiteTheme());
        }
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <slot name="head" />
    <Font cssVariable="--font-fredoka" preload />
    <Font cssVariable="--font-nunito" preload />
    <Font cssVariable="--font-jetbrains" preload={mono} />
    {jpHeadings && <link rel="preload" href="/fonts/zen-maru-kana-700.woff2" as="font" type="font/woff2" crossorigin />}
    {jpHeadings && <link rel="preload" href="/fonts/zen-maru-700.woff2" as="font" type="font/woff2" crossorigin />}
    {/* 最初に目にする矢印と指さしだけ先読みする。端末のテーマに合う方を読む。 */}
    <link rel="preload" href="/cursors/arrow.svg" as="image" type="image/svg+xml" media="(hover: hover) and (pointer: fine) and (prefers-color-scheme: light)" />
    <link rel="preload" href="/cursors/point.svg" as="image" type="image/svg+xml" media="(hover: hover) and (pointer: fine) and (prefers-color-scheme: light)" />
    <link rel="preload" href="/cursors/arrow-dark.svg" as="image" type="image/svg+xml" media="(hover: hover) and (pointer: fine) and (prefers-color-scheme: dark)" />
    <link rel="preload" href="/cursors/point-dark.svg" as="image" type="image/svg+xml" media="(hover: hover) and (pointer: fine) and (prefers-color-scheme: dark)" />
    <ClientRouter />
  </head>
  <body class="min-h-dvh flex flex-col">
    <div class="sea" aria-hidden="true" transition:persist="sea">
      {RAYS.map((r) => <i class="ray" style={`--x:${r.x}%;--w:${r.w}%;--a:${r.a};--d:${r.d}s;--o:-${r.o}s`}></i>)}
      <i class="sun"></i>
      <canvas class="deep"></canvas>
      <canvas class="caustic"></canvas>
      <canvas class="surface"></canvas>
    </div>
    <a href="#content" class="skip-link pill pill-accent">本文へ移動</a>
    <script>
      import { installSmoothScroll } from '../scripts/smooth-scroll';
      import { startSurface } from '../scripts/surface';
      import { startDeep, touchDeep } from '../scripts/deep';
      import { isDark } from '../scripts/theme';
      import type { BackgroundControl } from '../scripts/background';
      import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';
      installSmoothScroll();
      // 作品ページが絡む遷移では、その作品だけをモーフさせる。一覧の他のカードが前後リンクへ飛ぶのを防ぐ。
      let focusWork: string | undefined;
      const workId = (url: URL) => url.pathname.match(/^\/works\/([^/]+)\/?$/)?.[1];
      const isolateWork = () => {
        if (!focusWork) return;
        document.querySelectorAll<HTMLElement>('[data-astro-transition-scope]').forEach((el) => {
          const id = getComputedStyle(el).viewTransitionName.match(/^work-(?:title-|caption-|icon-)?(.+)$/)?.[1];
          if (id && id !== focusWork) el.style.viewTransitionName = 'none';
        });
      };
      // 「← Works」のような戻りリンクは、履歴の戻ると同じ向きで遷移させる。
      document.addEventListener('astro:before-preparation', (e) => {
        const ev = e as TransitionBeforePreparationEvent;
        if (ev.sourceElement?.closest('[data-vt-back]')) ev.direction = 'back';
        focusWork = workId(ev.to) ?? workId(ev.from);
      });
      document.addEventListener('astro:after-preparation', isolateWork);
      document.addEventListener('astro:after-swap', () => { isolateWork(); focusWork = undefined; });
      let bg: BackgroundControl[] = [];
      const boot = () => {
        bg.forEach((b) => b.dispose());
        const s = document.querySelector<HTMLCanvasElement>('canvas.surface');
        const d = document.querySelector<HTMLCanvasElement>('canvas.deep');
        bg = [s && startSurface(s), d && startDeep(d)].filter((x): x is BackgroundControl => !!x);
      };
      boot();
      // 海は transition:persist で残し、WebGL とシェーダーを作り直さない。Canvas が入れ替わったときだけ作り直す。
      let booted = document.querySelector('canvas.surface');
      document.addEventListener('astro:after-swap', () => {
        const now = document.querySelector('canvas.surface');
        if (now !== booted) { booted = now; boot(); }
      });
      // 泡は深い海でだけ立てる。動きを減らす設定では深い海は止まっているので何もしない。
      const still = matchMedia('(prefers-reduced-motion: reduce)');
      let lastX = 0, lastY = 0, lastT = 0, travel = 0;
      addEventListener('pointermove', (ev) => {
        // 指の動きはスクロールなので数えない。
        if (ev.pointerType !== 'mouse' || still.matches || !isDark()) return;
        travel += Math.hypot(ev.clientX - lastX, ev.clientY - lastY);
        lastX = ev.clientX; lastY = ev.clientY;
        if (travel < 140 || ev.timeStamp - lastT < 50) return;
        travel = 0; lastT = ev.timeStamp;
        touchDeep(ev.clientX, ev.clientY, false);
      }, { passive: true });
      addEventListener('pointerdown', (ev) => { if (!still.matches && isDark()) touchDeep(ev.clientX, ev.clientY, true); }, { passive: true });
      const grid = () => import('../scripts/design-grid');
      addEventListener('keydown', (ev) => {
        if ((ev.key !== 'g' && ev.key !== 'G') || ev.metaKey || ev.ctrlKey || ev.altKey || ev.isComposing) return;
        if ((ev.target as Element).closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])')) return;
        grid().then((m) => m.toggleDesignGrid());
      });
      document.addEventListener('click', (ev) => {
        if ((ev.target as Element).closest('[data-grid-toggle]')) grid().then((m) => m.toggleDesignGrid());
      });
      let restore = new URLSearchParams(location.search).has('grid');
      try { restore ||= sessionStorage.getItem('design-grid') === '1'; } catch {}
      if (restore) grid().then((m) => m.showDesignGrid());
    </script>
    <Header />
    {/* 本文幅のページも列はサイト幅に取り、内容の左端をロゴにそろえる。 */}
    <main id="content" tabindex="-1" transition:name="main" transition:animate="initial" class="outline-none flex-1 w-full max-w-site mx-auto px-4 sm:px-8 pt-12 pb-16">
      {wide ? <slot /> : <div class="max-w-reading"><slot /></div>}
    </main>
    <Footer />
  </body>
</html>
