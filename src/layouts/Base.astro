---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { ClientRouter } from 'astro:transitions';
import { componentDataByCssVariable } from 'virtual:astro:assets/fonts/internal';
// 先に必要になるラテン文字のフォントだけ preload する(見出しの Fredoka と本文の Nunito)
const preloads = ['--font-fredoka', '--font-nunito'].flatMap((v) => componentDataByCssVariable.get(v)?.preloads ?? []);

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title, description = SITE.description, wide = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // 保存したテーマがあれば color-scheme を固定、無ければ OS に追従。遷移で <html> が差し替わるたびに再適用
      (() => {
        const apply = () => {
          const t = localStorage.getItem('theme');
          const h = document.documentElement;
          h.classList.toggle('dark', t === 'dark');
          h.classList.toggle('light', t === 'light');
          document.querySelector('meta[name="color-scheme"]').content = t ?? 'light dark';
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {preloads.map((p) => <link rel="preload" href={p.url} as="font" type={`font/${p.type}`} crossorigin />)}
    <link rel="stylesheet" href="/fonts.css" />
    <ClientRouter />
  </head>
  <body class="min-h-dvh flex flex-col">
    <!-- 背景: 深海の気配。水面から差す光と、ゆっくり昇るマリンスノー(装飾。本文の裏、CSS のみ) -->
    <div class="sea" aria-hidden="true"><i class="rays"></i><i class="snow"></i><i class="snow far"></i></div>
    <a href="#content" class="skip-link pill pill-accent">本文へ移動</a>
    <script>
      import { installSmoothScroll } from '../scripts/smooth-scroll';
      installSmoothScroll();
    </script>
    <Header />
    <main id="content" tabindex="-1" transition:name="main" class:list={['outline-none flex-1 w-full mx-auto px-4 sm:px-8 pt-12 pb-24', wide ? 'max-w-[64rem]' : 'max-w-[42rem]']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
