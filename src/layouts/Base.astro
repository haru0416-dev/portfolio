---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { labFromPath } from '../data/lab';
import { rootColorStyle, THEME_COLOR } from '../palette';
import { ClientRouter } from 'astro:transitions';
import { componentDataByCssVariable } from 'virtual:astro:assets/fonts/internal';
const preloads = ['--font-fredoka', '--font-nunito'].flatMap((v) => componentDataByCssVariable.get(v)?.preloads ?? []);

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  image?: { src: string; alt: string };
  type?: 'website' | 'article';
  jpHeadings?: boolean;
}
const { title, description = SITE.description, wide = false, image, type = 'website', jpHeadings = true } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const lab = labFromPath(Astro.url.pathname);
// 光の筋は位置・幅・濃さ・揺れの周期をばらばらにし、等間隔に見えないようにする。
const RAYS = [
  { x: 6, w: 9, a: 0.55, d: 41, o: 7 },
  { x: 19, w: 5, a: 0.9, d: 29, o: 18 },
  { x: 27, w: 12, a: 0.7, d: 53, o: 31 },
  { x: 46, w: 6, a: 1, d: 37, o: 4 },
  { x: 63, w: 10, a: 0.6, d: 47, o: 22 },
  { x: 71, w: 4, a: 0.8, d: 33, o: 12 },
  { x: 86, w: 8, a: 0.65, d: 59, o: 40 },
];
const social = image ?? (lab ? { src: `/og/lab/${lab.slug}.png`, alt: `実験「${lab.title}」の題名と haru0416.dev` } : undefined);
const socialImage = new URL(social?.src ?? '/og.png', Astro.site);
const socialImageAlt = social?.alt ?? 'haru のロゴと Rust / TypeScript、haru0416.dev';
---
<!doctype html>
<html lang="ja" style={rootColorStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" data-light={THEME_COLOR.light} data-dark={THEME_COLOR.dark} />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" data-light={THEME_COLOR.light} data-dark={THEME_COLOR.dark} />
    <script is:inline>
      // 初回描画より先に実行し、保存済みテーマとのちらつきを防ぐ。
      (() => {
        const apply = () => {
          const t = localStorage.getItem('theme');
          const h = document.documentElement;
          h.classList.toggle('dark', t === 'dark');
          h.classList.toggle('light', t === 'light');
          const scheme = document.querySelector('meta[name="color-scheme"]');
          if (scheme) scheme.content = t === 'light' || t === 'dark' ? t : 'light dark';
          document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
            m.content = t === 'light' || t === 'dark' ? m.dataset[t] : m.media.includes('dark') ? m.dataset.dark : m.dataset.light;
          });
        };
        globalThis.applySiteTheme = apply;
        apply();
        if (!globalThis.__themeSwapBound) {
          globalThis.__themeSwapBound = true;
          document.addEventListener('astro:after-swap', () => globalThis.applySiteTheme());
        }
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <slot name="head" />
    {preloads.map((p) => <link rel="preload" href={p.url} as="font" type={`font/${p.type}`} crossorigin />)}
    <link rel="stylesheet" href="/fonts.css" />
    {jpHeadings && <link rel="preload" href="/fonts/zen-maru-kana-700.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/cursors/arrow.svg" as="image" type="image/svg+xml" media="(hover: hover) and (pointer: fine)" />
    <link rel="preload" href="/cursors/sprout.svg" as="image" type="image/svg+xml" media="(hover: hover) and (pointer: fine)" />
    <ClientRouter />
  </head>
  <body class="min-h-dvh flex flex-col">
    <div class="sea" aria-hidden="true">
      {RAYS.map((r) => <i class="ray" style={`--x:${r.x}%;--w:${r.w}%;--a:${r.a};--d:${r.d}s;--o:-${r.o}s`}></i>)}
      <i class="sun"></i>
      <canvas class="deep"></canvas>
      <canvas class="surface"></canvas>
    </div>
    <a href="#content" class="skip-link pill pill-accent">本文へ移動</a>
    <script>
      import { installSmoothScroll } from '../scripts/smooth-scroll';
      import { startSurface } from '../scripts/surface';
      import { startDeep } from '../scripts/deep';
      import type { BackgroundControl } from '../scripts/background';
      import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';
      installSmoothScroll();
      // 作品ページが絡む遷移では、その作品だけをモーフさせる。一覧の他のカードが前後リンクへ飛ぶのを防ぐ。
      let focusWork: string | undefined;
      const workId = (url: URL) => url.pathname.match(/^\/works\/([^/]+)\/?$/)?.[1];
      const isolateWork = () => {
        if (!focusWork) return;
        document.querySelectorAll<HTMLElement>('[data-astro-transition-scope]').forEach((el) => {
          const id = getComputedStyle(el).viewTransitionName.match(/^work-(?:title-|caption-|icon-)?(.+)$/)?.[1];
          if (id && id !== focusWork) el.style.viewTransitionName = 'none';
        });
      };
      // 「← Works」のような戻りリンクは、履歴の戻ると同じ向きで遷移させる。
      document.addEventListener('astro:before-preparation', (e) => {
        const ev = e as TransitionBeforePreparationEvent;
        if (ev.sourceElement?.closest('[data-vt-back]')) ev.direction = 'back';
        focusWork = workId(ev.to) ?? workId(ev.from);
      });
      document.addEventListener('astro:after-preparation', isolateWork);
      document.addEventListener('astro:after-swap', () => { isolateWork(); focusWork = undefined; });
      let bg: BackgroundControl[] = [];
      const boot = () => {
        bg.forEach((b) => b.dispose());
        const s = document.querySelector<HTMLCanvasElement>('canvas.surface');
        const d = document.querySelector<HTMLCanvasElement>('canvas.deep');
        bg = [s && startSurface(s), d && startDeep(d)].filter((x): x is BackgroundControl => !!x);
      };
      boot();
      document.addEventListener('astro:after-swap', boot);
    </script>
    <Header />
    <main id="content" tabindex="-1" transition:name="main" transition:animate="initial" class:list={['outline-none flex-1 w-full mx-auto px-4 sm:px-8 pt-12 pb-16', wide ? 'max-w-site' : 'max-w-reading']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
