---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { ClientRouter } from 'astro:transitions';
import { componentDataByCssVariable } from 'virtual:astro:assets/fonts/internal';
// 先に必要になるラテン文字のフォントだけ preload する(見出しの Fredoka と本文の Nunito)
const preloads = ['--font-fredoka', '--font-nunito'].flatMap((v) => componentDataByCssVariable.get(v)?.preloads ?? []);

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title, description = SITE.description, wide = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // 保存したテーマがあれば color-scheme を固定、無ければ OS に追従。遷移で <html> が差し替わるたびに再適用
      (() => {
        const apply = () => {
          const t = localStorage.getItem('theme');
          const h = document.documentElement;
          h.classList.toggle('dark', t === 'dark');
          h.classList.toggle('light', t === 'light');
          document.querySelector('meta[name="color-scheme"]').content = t ?? 'light dark';
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {preloads.map((p) => <link rel="preload" href={p.url} as="font" type={`font/${p.type}`} crossorigin />)}
    <link rel="stylesheet" href="/fonts.css" />
    <ClientRouter />
  </head>
  <body class="min-h-dvh flex flex-col">
    <!-- 背景(装飾。本文の裏、CSS のみ)。ダークは深海(光の帯・泡・マリンスノー)、ライトは水面(波紋・日差しのきらめき)。
         出ない側は色を透明にして隠す -->
    <div class="sea" aria-hidden="true">
      <i class="rays"></i><i class="rays rays-2"></i>
      <i class="snow"></i><i class="snow far"></i>
      <span class="bubbles">{Array.from({ length: 10 }, () => <i></i>)}</span>
      <!-- 水面のゆらめき(ライト): ノイズで一度だけ描いた有機的な模様を 2 層、逆向きにゆっくり流す -->
      <svg class="caustics" viewBox="0 0 960 540" preserveAspectRatio="none">
        <filter id="caustic" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feTurbulence type="turbulence" baseFrequency="0.009 0.014" numOctaves="2" seed="11" />
          <feColorMatrix type="matrix" values="0 0 0 0 0.60  0 0 0 0 0.74  0 0 0 0 0.92  0.9 0.9 0.9 0 -0.55" />
        </filter>
        <rect width="960" height="540" filter="url(#caustic)" />
      </svg>
      <svg class="caustics caustics-2" viewBox="0 0 960 540" preserveAspectRatio="none">
        <filter id="caustic-2" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feTurbulence type="turbulence" baseFrequency="0.006 0.010" numOctaves="2" seed="29" />
          <feColorMatrix type="matrix" values="0 0 0 0 0.60  0 0 0 0 0.74  0 0 0 0 0.92  0.9 0.9 0.9 0 -0.6" />
        </filter>
        <rect width="960" height="540" filter="url(#caustic-2)" />
      </svg>
      <span class="ripples">{Array.from({ length: 3 }, () => <i></i>)}</span>
      <span class="glints">{Array.from({ length: 5 }, () => <i></i>)}</span>
    </div>
    <a href="#content" class="skip-link pill pill-accent">本文へ移動</a>
    <script>
      import { installSmoothScroll } from '../scripts/smooth-scroll';
      installSmoothScroll();
    </script>
    <Header />
    <main id="content" tabindex="-1" transition:name="main" class:list={['outline-none flex-1 w-full mx-auto px-4 sm:px-8 pt-12 pb-24', wide ? 'max-w-[64rem]' : 'max-w-[42rem]']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
