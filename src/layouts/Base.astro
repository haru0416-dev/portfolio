---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import { ClientRouter } from 'astro:transitions';
import { componentDataByCssVariable } from 'virtual:astro:assets/fonts/internal';
// 先に必要になるラテン文字のフォントだけ preload する(見出しの Fredoka と本文の Nunito)
const preloads = ['--font-fredoka', '--font-nunito'].flatMap((v) => componentDataByCssVariable.get(v)?.preloads ?? []);

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  /** 共有用画像。省略するとサイト共通の /og.png */
  image?: { src: string; alt: string };
  type?: 'website' | 'article';
  /** 和文の見出し(.display-jp)が無いページは false。見出し用の書体を先読みしない */
  jpHeadings?: boolean;
}
const { title, description = SITE.description, wide = false, image, type = 'website', jpHeadings = true } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image?.src ?? '/og.png', Astro.site);
const socialImageAlt = image?.alt ?? 'haru のロゴと Rust / TypeScript、haru0416.dev';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <!-- --paper の地の色(OKLCH を sRGB に変換した値) -->
    <meta name="theme-color" content="#f8f5fd" media="(prefers-color-scheme: light)" data-light="#f8f5fd" data-dark="#15121c" />
    <meta name="theme-color" content="#15121c" media="(prefers-color-scheme: dark)" data-light="#f8f5fd" data-dark="#15121c" />
    <script is:inline>
      // 保存したテーマがあれば color-scheme を固定、無ければ OS に追従。遷移で <html> が差し替わるたびに再適用
      (() => {
        const apply = () => {
          const t = localStorage.getItem('theme');
          const h = document.documentElement;
          h.classList.toggle('dark', t === 'dark');
          h.classList.toggle('light', t === 'light');
          document.querySelector('meta[name="color-scheme"]').content = t ?? 'light dark';
          // テーマを固定したときは OS の設定によらずその色、固定していなければ OS に合わせた色
          document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
            m.content = t === 'light' || t === 'dark' ? m.dataset[t] : m.media.includes('dark') ? m.dataset.dark : m.dataset.light;
          });
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <slot name="head" />
    {preloads.map((p) => <link rel="preload" href={p.url} as="font" type={`font/${p.type}`} crossorigin />)}
    <link rel="stylesheet" href="/fonts.css" />
    {jpHeadings && <link rel="preload" href="/fonts/zen-maru-kana-700.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/cursors/arrow.svg" as="image" type="image/svg+xml" media="(hover: hover) and (pointer: fine)" />
    <link rel="preload" href="/cursors/sprout.svg" as="image" type="image/svg+xml" media="(hover: hover) and (pointer: fine)" />
    <ClientRouter />
  </head>
  <body class="min-h-dvh flex flex-col">
    <!-- 背景(装飾。本文の裏、CSS のみ)。ダークは深海(光の帯・泡・マリンスノー)、ライトは水面(波紋・日差しのきらめき)。
         出ない側は色を透明にして隠す -->
    <div class="sea" aria-hidden="true">
      <i class="rays"></i><i class="rays rays-2"></i>
      <canvas class="deep"></canvas>
      <canvas class="surface"></canvas>
    </div>
    <a href="#content" class="skip-link pill pill-accent">本文へ移動</a>
    <script>
      import { installSmoothScroll } from '../scripts/smooth-scroll';
      import { startSurface } from '../scripts/surface';
      import { startDeep } from '../scripts/deep';
      import type { BackgroundControl } from '../scripts/background';
      installSmoothScroll();
      // 背景(ライト: 水面 / ダーク: 深海)。ページ遷移で canvas が差し替わるので、そのたびに付け直す
      let bg: BackgroundControl[] = [];
      const boot = () => {
        bg.forEach((b) => b.dispose());
        const s = document.querySelector<HTMLCanvasElement>('canvas.surface');
        const d = document.querySelector<HTMLCanvasElement>('canvas.deep');
        bg = [s && startSurface(s), d && startDeep(d)].filter((x): x is BackgroundControl => !!x);
      };
      boot();
      document.addEventListener('astro:after-swap', boot);
    </script>
    <Header />
    <!-- 本文だけのページの幅は、広いページの中身の幅(960px)を黄金比で割ったもの(960 ÷ φ ≒ 592px。左右の余白を足して 41rem) -->
    <main id="content" tabindex="-1" transition:name="main" class:list={['outline-none flex-1 w-full mx-auto px-4 sm:px-8 pt-12 pb-24', wide ? 'max-w-[64rem]' : 'max-w-[41rem]']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
