---
// 作品ページ。src/content/works/<id>.md の frontmatter から見出し・リンク・技術を出し、本文があれば続けて載せる
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
  return works.map((work, i) => ({
    params: { id: work.id },
    props: { work, prev: works[i - 1], next: works[i + 1] },
  }));
}
const { work, prev, next } = Astro.props;
const { Content } = await render(work);
const d = work.data;
const hasBody = Boolean(work.body?.trim());
const badge = { active: '', wip: 'Work in progress', soon: 'Coming soon', archived: 'Archived' } as const;
const showRepo = d.repo && d.status !== 'soon';

const url = new URL(`/works/${work.id}/`, Astro.site).href;
// 検索エンジン向けの作品情報(schema.org)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: d.name,
  description: d.summary,
  url,
  image: new URL(`/og/works/${work.id}.png`, Astro.site).href,
  programmingLanguage: d.stack,
  ...(showRepo ? { codeRepository: d.repo } : {}),
  ...(d.url ? { sameAs: d.url } : {}),
  author: { '@type': 'Person', name: SITE.name, url: SITE.github },
};
---
<Base
  title={d.name}
  description={d.summary}
  image={{ src: `/og/works/${work.id}.png`, alt: `作品「${d.name}」の名前とアイコン、haru0416.dev` }}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />
  <article>
    <header class="mb-12">
      <a href="/works/" class="u-link inline-flex items-center min-h-6 text-xs tracking-[.08em] uppercase text-muted hover:text-ink mb-6">← Works</a>
      <div class="flex items-center gap-4">
        <Tile icon={d.icon as any} size={64} class="hue-0" />
        <h1 class="display-jp text-2xl sm:text-3xl min-w-0">{d.name}</h1>
      </div>
      <p class="mt-6 text-base text-ink-2">{d.summary}</p>
      <div class="mt-4 flex flex-wrap gap-2 on-paper">
        {badge[d.status] && <span class="tag badge tracking-[.1em] uppercase">{badge[d.status]}</span>}
        {d.stack.map((s) => <span class="tag">{s}</span>)}
      </div>
      {(d.url || showRepo || d.issues) && (
        <div class="mt-8 flex flex-wrap gap-2">
          {d.url && <a href={d.url} class="pill pill-accent press">サイトを開く</a>}
          {showRepo && <a href={d.repo} class="pill glass press">GitHub</a>}
          {d.issues && <a href={d.issues} class="pill glass press">感想・不具合を送る</a>}
        </div>
      )}
      {d.issues && <p class="mt-4 text-xs text-muted">感想・不具合は GitHub Issues で受け付けています（投稿には GitHub へのログインが必要で、内容は公開されます）。</p>}
    </header>

    {hasBody && <div class="prose"><Content /></div>}
  </article>

  {(prev || next) && <nav aria-label="前後の作品" class="mt-16 pt-8 dotted grid grid-cols-2 gap-4 sm:gap-8 text-sm">
    <div>
      {prev && (
        <a href={`/works/${prev.id}/`} class="group block">
          <div class="text-xs tracking-[.12em] uppercase text-muted mb-1">← Prev</div>
          <div class="display-jp text-base group-hover:text-accent transition-colors">{prev.data.name}</div>
        </a>
      )}
    </div>
    <div class="text-right">
      {next && (
        <a href={`/works/${next.id}/`} class="group block">
          <div class="text-xs tracking-[.12em] uppercase text-muted mb-1">Next →</div>
          <div class="display-jp text-base group-hover:text-accent transition-colors">{next.data.name}</div>
        </a>
      )}
    </div>
  </nav>}
</Base>
