---
import { getWorks, WORK_STATUS_LABELS } from '../../data/collections';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import WorkCover from '../../components/WorkCover.astro';
const works = await getWorks();
const stacks = [...new Set(works.flatMap((w) => w.data.stack))].sort((a, b) => a.localeCompare(b, 'en'));
---
<Base title="Works" wide>
  <Hero title="Works" lead="作ったツールをいくつか紹介しています。ほかのプロジェクトは GitHub にあります。" />

  <search aria-label="技術で絞り込む" class="mb-6">
    <div id="stack-filter" class="scroll-row -mx-4 px-4 sm:mx-0 sm:px-0 flex gap-2 sm:flex-wrap">
      <button type="button" class="chip glass press" data-stack="" aria-pressed="true" aria-controls="work-results">すべて</button>
      {stacks.map((s) => <button type="button" class="chip glass press" data-stack={s} aria-pressed="false" aria-controls="work-results">#{s}</button>)}
    </div>
    <p id="stack-status" class="mt-2 text-sm text-muted" role="status" aria-live="polite" aria-atomic="true">{works.length} 件の作品</p>
  </search>

  <div id="work-results">
    <ul role="list" class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {works.map((w, i) => (
        <li class="reveal" data-work data-stack={JSON.stringify(w.data.stack)}>
          <a href={`/works/${w.id}/`} transition:name={`work-${w.id}`} transition:animate="initial" class="work-card group">
            <WorkCover id={w.id} icon={w.data.icon} cover={w.data.cover} hue={i} loading={i < 3 ? 'eager' : 'lazy'} />
            {WORK_STATUS_LABELS[w.data.status] && <span class="tag badge absolute top-4 left-4 z-1 tracking-[.1em] uppercase">{WORK_STATUS_LABELS[w.data.status]}</span>}
            <span transition:name={`work-caption-${w.id}`} transition:animate="initial" class="caption vt-caption">
              <span transition:name={`work-title-${w.id}`} transition:animate="initial" class="vt-swap display-jp block w-fit max-w-full text-base leading-6 line-clamp-2">{w.data.name}</span>
              <span class="block text-xs leading-4 mt-1 opacity-80 truncate">{w.data.stack.join(' · ')}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div id="stack-empty" hidden={works.length > 0}>
      <p class="text-sm text-muted">{works.length === 0 ? 'まだ作品がありません。' : 'この技術を使った作品はありません。'}</p>
      {works.length > 0 && <button id="stack-reset" type="button" class="chip glass press mt-4" aria-controls="work-results">すべての作品を表示</button>}
    </div>
  </div>

  <section id="feedback" aria-labelledby="feedback-heading" class="mt-16 pt-8 dotted scroll-mt-24">
    <h2 id="feedback-heading" class="display-jp text-2xl mb-4">感想・不具合の報告</h2>
    <div class="max-w-[44rem] space-y-4 text-sm text-ink-2">
      <p>作品への感想や不具合は、各作品ページの「感想・不具合を送る」から GitHub Issues へお願いします。投稿には GitHub へのログインが必要です。</p>
      <p>投稿内容は公開されます。個人情報や、公開したくない会話ログ・認証情報などは書き込まないでください。</p>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/filter';
</script>
