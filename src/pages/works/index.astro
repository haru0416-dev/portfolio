---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Tile from '../../components/Tile.astro';
import { ICONS } from '../../data/icons';
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const badge = { active: '', wip: 'Work in progress', soon: 'Coming soon', archived: 'Archived' } as const;
const Code = ICONS.code, Ext = ICONS['external-link'];
---
<Base title="Works" wide>
  <Hero eyebrow="Works" title="Selected works" lead="作ったツールをいくつか紹介しています。ほかのプロジェクトは GitHub にあります。" />
  <ul role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {works.map((w, i) => (
      <li class="card glass reveal flex flex-col gap-4 group">
        <div class="flex items-center gap-4">
          <Tile icon={w.data.icon as any} size={48} class={`hue-${i % 3}`} />
          <h2 class="display-jp text-lg min-w-0 flex-1"><a href={`/works/${w.id}/`} class="card-link group-hover:text-accent transition-colors">{w.data.name}</a></h2>
        </div>
        <p class="text-sm text-ink-2 flex-1">{w.data.summary}</p>
        <div class="flex items-end gap-2 min-h-8">
          <div class="flex flex-wrap gap-2 flex-1 pb-1">
            {/* 状態は見出しの横に置くと題名が押しつぶされるので、タグの先頭に差し色で置く */}
            {badge[w.data.status] && <span class="tag badge tracking-[.1em] uppercase">{badge[w.data.status]}</span>}
            {w.data.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
          {w.data.url && <a href={w.data.url} class="icon-btn icon-btn-accent press relative z-1" aria-label={`${w.data.name} のサイトを開く`}><Ext size={14} stroke-width={2.5} aria-hidden="true" /></a>}
          {w.data.repo && w.data.status !== 'soon' && <a href={w.data.repo} class="icon-btn glass press relative z-1" aria-label={`${w.data.name} のリポジトリを開く`}><Code size={14} stroke-width={2.5} aria-hidden="true" /></a>}
        </div>
      </li>
    ))}
  </ul>

  <section id="feedback" aria-labelledby="feedback-heading" class="mt-16 pt-8 dotted scroll-mt-24">
    <h2 id="feedback-heading" class="display-jp text-2xl mb-4">感想・不具合の報告</h2>
    <div class="max-w-[44rem] space-y-4 text-sm text-ink-2">
      <p>下記の作品への感想や不具合は、それぞれの GitHub Issues へお願いします。投稿には GitHub へのログインが必要です。</p>
      <p>投稿内容は公開されます。個人情報や、公開したくない会話ログ・認証情報などは書き込まないでください。</p>
      <ul role="list" class="space-y-2">
        {works.filter((w) => w.data.issues).map((w) => (
          <li><a href={w.data.issues} class="u-link hover:text-ink inline-flex items-center min-h-6">{w.data.name} の GitHub Issues →</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
