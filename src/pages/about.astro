---
import '../styles/prose.css';
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import { getPublishedPosts, getWorks } from '../data/collections';
import { LAB } from '../data/lab';
import { formatDate } from '../date';
import { SITE } from '../site';
import Sticker from '../components/Sticker.astro';
import { SITE_ICON } from '../data/icons';
import Rss from '@lucide/astro/icons/rss';
import Bug from '@lucide/astro/icons/bug';
import Grid from '@lucide/astro/icons/grid-3x3';
import Notebook from '@lucide/astro/icons/notebook-pen';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Flask from '@lucide/astro/icons/flask-conical';
import GitHubMark from '../assets/icons/github.svg';

const works = await getWorks();
// 作品の stack を集計し、言語とそれ以外に分ける。言語は定義順、それ以外は使っている作品の多い順。このサイト自体も Astro の使用例として数える。
const LANGUAGES = ['Rust', 'TypeScript', 'Python', 'C'];
const uses = new Map<string, number>([['Astro', 1]]);
for (const s of works.flatMap((w) => w.data.stack)) uses.set(s, (uses.get(s) ?? 0) + 1);
const skills = [
  { label: '言語', items: LANGUAGES.filter((s) => uses.has(s)) },
  { label: 'ランタイム・ライブラリ', items: [...uses.keys()].filter((s) => !LANGUAGES.includes(s)).sort((a, b) => uses.get(b)! - uses.get(a)! || a.localeCompare(b, 'en')) },
];
const githubUser = SITE.github.replace(/^https:\/\/github\.com\//, '');

// 記事と Lab を日付の新しい順に並べ、年ごとにまとめる。作品は公開日を持たないため含めない。
const KINDS = {
  blog: { label: 'Blog', action: 'Blog に記事を公開', Icon: Notebook },
  lab: { label: 'Lab', action: 'Lab に実験を公開', Icon: Flask },
} as const;
type Kind = keyof typeof KINDS;
const log = [
  ...(await getPublishedPosts()).map((p) => ({ kind: 'blog' as Kind, date: formatDate(p.data.pubDate), title: p.data.title, description: p.data.description, href: `/blog/${p.id}/` })),
  ...LAB.map((l) => ({ kind: 'lab' as Kind, date: l.date, title: l.title, description: l.description, href: `/lab/${l.slug}/` })),
].sort((a, b) => b.date.localeCompare(a.date) || a.kind.localeCompare(b.kind));
const years = [...new Set(log.map((e) => e.date.slice(0, 4)))].map((year) => ({ year, entries: log.filter((e) => e.date.startsWith(year)) }));
const counts = Object.fromEntries((Object.keys(KINDS) as Kind[]).map((k) => [k, log.filter((e) => e.kind === k).length]));
---
<Base title="About" description="自己紹介。Rust や TypeScript でツールや研究的なものを作ったりしてます。" wide image={{ src: '/og/about.png', alt: `自己紹介「Hi, I'm ${SITE.name}.」と haru0416.dev` }}>
  <header class="flex items-end justify-between gap-6 pt-4">
    <h1>
      <span class="display block text-lg leading-8 sm:text-xl text-ink-2 hero-lead">Hi, I'm</span>
      <span class="display block text-5xl min-[22.5rem]:text-6xl sm:text-7xl tracking-[-0.01em]"><Wordmark text={SITE.name} /><span class="text-accent">.</span></span>
    </h1>
    {/* イラストに差し替える枠。下端を名前の行の下端にそろえ、同じ地面に立たせる。 */}
    <div aria-hidden="true" class="about-hero-art hero-lead">
      <Sticker icon={SITE_ICON} lift class="text-accent" />
    </div>
  </header>

  <div class="mt-12 pt-12 dotted grid gap-16 lg:grid-cols-2">
    <section aria-labelledby="about-me">
      <h2 id="about-me" class="about-h2">About me</h2>
      <div class="prose">
        <p>Rust や TypeScript でツールや研究的なものを作ったりしてます。</p>
        <p>面白そうだなって思ったものをプレで作ってみたり、それを実際に実装してみたりといろいろ試し中です。</p>
        <p>このサイトには、作ったツールとかを <a href="/works/">Works</a> に、今後気ままにかけたらいいなって思っている <a href="/blog/">Blog</a> に、ブラウザで動く面白そうだと思っているものを <a href="/lab/">Lab</a> に載せて行く予定です。</p>
      </div>
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills" class="about-h2">Skills</h2>
      {skills.map((g) => (
        <div class="skill-group">
          <h3 class="display-jp text-lg leading-8">{g.label}</h3>
          <ul role="list" class="mt-2 flex flex-wrap gap-2">
            {g.items.map((s) => <li class="tag">{s}</li>)}
          </ul>
        </div>
      ))}
    </section>
  </div>

  <section aria-labelledby="changelog" class="mt-24">
    <h2 id="changelog" class="about-h2">Changelog</h2>
    <div role="group" aria-label="種類で絞り込む" class="flex flex-wrap gap-2 mb-8" data-changelog-filter>
      <button type="button" class="chip glass press" data-kind="" aria-pressed="true" aria-controls="changelog-list">すべて<span class="chip-count">{log.length}</span></button>
      {(Object.keys(KINDS) as Kind[]).map((k) => (
        <button type="button" class="chip glass press" data-kind={k} aria-pressed="false" aria-controls="changelog-list">{KINDS[k].label}<span class="chip-count">{counts[k]}</span></button>
      ))}
    </div>
    <div id="changelog-list" class="max-w-reading space-y-12">
      {years.map(({ year, entries }) => (
        <section aria-labelledby={`cl-${year}`} class="cl-year">
          <h3 id={`cl-${year}`} class="display text-xl leading-8">{year}</h3>
          <ol role="list" class="cl-list mt-4">
            {entries.map((e, i) => {
              const { action, Icon } = KINDS[e.kind];
              return (
                <li class="cl-item" data-kind={e.kind} data-last={i === entries.length - 1 ? '' : undefined}>
                  <div class="flex items-center gap-2 h-6 text-sm text-muted">
                    <span class="cl-dot" aria-hidden="true"><Icon size={14} stroke-width={2.25} /></span>
                    {action}
                    <time datetime={e.date} class="tag tabular-nums">{e.date.slice(5).replace('-', '.')}</time>
                  </div>
                  <a href={e.href} class="cl-card press">
                    <span class="display-jp block text-base leading-6">{e.title}</span>
                    {e.description && <span class="block text-sm leading-6 text-ink-2 truncate">{e.description}</span>}
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </section>

  <section aria-labelledby="about-links" class="mt-24">
    <h2 id="about-links" class="about-h2">Links</h2>
    <ul role="list" class="bento">
      <li class="bento-lg">
        <a href={SITE.github} class="tile press">
          <GitHubMark width={32} height={32} aria-hidden="true" />
          <span class="tile-text">
            <span class="display text-2xl leading-8">GitHub</span>
            <span class="text-sm text-muted">@{githubUser}</span>
          </span>
        </a>
      </li>
      <li>
        <a href="/blog/" class="tile press">
          <Notebook size={24} stroke-width={2} aria-hidden="true" />
          <span class="tile-text"><span class="font-bold">Blog</span><span class="text-xs text-muted">開発メモ</span></span>
        </a>
      </li>
      <li>
        <a href="/rss.xml" class="tile press">
          <Rss size={24} stroke-width={2} aria-hidden="true" />
          <span class="tile-text"><span class="font-bold">RSS</span><span class="text-xs text-muted">記事の更新</span></span>
        </a>
      </li>
      <li>
        <a href="/works/#feedback" class="tile press">
          <Bug size={24} stroke-width={2} aria-hidden="true" />
          <span class="tile-text"><span class="font-bold">感想・不具合</span><span class="text-xs text-muted">GitHub Issues</span></span>
        </a>
      </li>
      <li>
        <button type="button" data-grid-toggle aria-pressed="false" aria-keyshortcuts="G" class="tile press">
          <Grid size={24} stroke-width={2} aria-hidden="true" />
          <span class="tile-text"><span class="font-bold">Design grid</span><span class="text-xs text-muted"><kbd>G</kbd> で寸法を重ねる</span></span>
        </button>
      </li>
    </ul>
  </section>

  <p class="mt-24 flex justify-center">
    <a href="#content" class="u-link inline-flex items-center gap-2 text-sm text-muted hover:text-ink">一番上に戻る<ArrowUp size={16} stroke-width={2} aria-hidden="true" /></a>
  </p>
</Base>

<script>
  // 絞り込みは見た目だけを切り替える。項目のない年は見出しごと隠す。
  document.addEventListener('astro:page-load', () => {
    const group = document.querySelector<HTMLElement>('[data-changelog-filter]');
    const list = document.getElementById('changelog-list');
    if (!group || !list) return;
    const buttons = group.querySelectorAll<HTMLButtonElement>('button[data-kind]');
    group.addEventListener('click', (ev) => {
      const btn = (ev.target as Element).closest<HTMLButtonElement>('button[data-kind]');
      if (!btn) return;
      const kind = btn.dataset.kind!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      list.querySelectorAll<HTMLElement>('.cl-item').forEach((li) => { li.hidden = kind !== '' && li.dataset.kind !== kind; });
      list.querySelectorAll<HTMLElement>('.cl-year').forEach((y) => {
        const shown = [...y.querySelectorAll<HTMLElement>('.cl-item:not([hidden])')];
        y.querySelectorAll('.cl-item').forEach((li) => li.toggleAttribute('data-last', li === shown.at(-1)));
        y.hidden = shown.length === 0;
      });
    });
  });
</script>

<style>
  .about-hero-art { flex-shrink: 0; width: 6rem; height: 6rem; }
  @media (min-width: 22.5rem) { .about-hero-art { width: 7rem; height: 7rem; } }
  @media (min-width: 40rem) { .about-hero-art { width: 15rem; height: 15rem; } }
  @supports (corner-shape: squircle) { .tile, .cl-card { corner-shape: squircle; } }

  /* アイコンの列に沿って点線を引き、項目を 1 本の時系列につなぐ。 */
  .cl-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .cl-item { position: relative; padding-left: 2rem; }
  .cl-item:not([data-last])::before { content: ""; position: absolute; left: .6875rem; top: 1.5rem; bottom: -1.5rem; border-left: 2px dotted var(--rule); }
  .cl-dot { position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; color: var(--accent-ink); background: var(--paper-2); box-shadow: inset 0 0 0 1px var(--line); }
  .cl-card {
    display: block; margin-top: .5rem; padding: 1rem 1.5rem; border-radius: 1rem; color: var(--ink); background: var(--paper-2);
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 1px var(--line);
    transition: background-color 150ms ease, transform 160ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .cl-card:hover { background: var(--accent-soft); } }

  .about-h2 { font-family: var(--font-display); font-weight: 600; font-size: var(--text-3xl); line-height: 3rem; margin-bottom: 1.5rem; }
  .skill-group + .skill-group { margin-top: 2rem; }

  .bento { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 8rem; gap: 1rem; }
  .bento-lg { grid-column: span 2; }
  @media (min-width: 64rem) {
    /* 段の高さ(128px)も間隔も 32 の倍数にし、2 段目も 32px の線に乗せる。 */
    .bento { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
    .bento-lg { grid-row: span 2; }
  }
  .tile {
    display: flex; flex-direction: column; justify-content: space-between; width: 100%; height: 100%; padding: 1.5rem;
    border-radius: 1.5rem; text-align: left; color: var(--ink); background: var(--paper-2);
    box-shadow: inset 0 1px 0 var(--glass-hi), inset 0 0 0 1px var(--line);
    transition: background-color 150ms ease, transform 160ms var(--ease-out);
  }
  .tile-text { display: flex; flex-direction: column; }
  .tile kbd { font: 700 var(--text-xs)/1rem var(--font-mono); padding: 0 .25rem; border-radius: .25rem; box-shadow: inset 0 0 0 1px var(--line); }
  .tile[aria-pressed="true"] { background: var(--accent-soft); }
  @media (hover: hover) and (pointer: fine) { .tile:hover { background: var(--accent-soft); } }
</style>
