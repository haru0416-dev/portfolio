---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import PostList from '../../components/PostList.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { readingMinutes } from '../../scripts/reading';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [latest, ...rest] = posts;
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const years = [...new Set(rest.map((p) => p.data.pubDate.getFullYear()))];
---
<Base title="Blog">
  <Hero eyebrow="Blog" title="Writing" lead="開発中に試したことを書いています。" />

  <div class="mb-8">
    {posts.length > 0 && (
      <search aria-label="タグで絞り込む">
        <div id="tag-filter" class="flex flex-wrap gap-2 mb-4">
          <button type="button" class="chip glass press" data-tag="" aria-pressed="true" aria-controls="blog-results">すべて</button>
          {tags.map((t) => <button type="button" class="chip glass press" data-tag={t} aria-pressed="false" aria-controls="blog-results">#{t}</button>)}
        </div>
      </search>
    )}
    <p id="tag-status" class="text-sm text-muted" role="status" aria-live="polite" aria-atomic="true">{posts.length} 件の記事</p>
  </div>

  <div id="blog-results">
    {latest && (
      <div data-post data-tags={JSON.stringify(latest.data.tags)}>
        <a href={`/blog/${latest.id}/`} class="card glass reveal block group mb-8">
          <div class="flex items-center gap-2 text-xs font-bold tracking-[.12em] uppercase text-accent-ink mb-2">
            <span>Latest</span><span class="text-muted">·</span>
            <FormattedDate date={latest.data.pubDate} class="text-muted" />
            <span class="text-muted">· {readingMinutes(latest.body)} min</span>
          </div>
          <h2 transition:name={`post-${latest.id}`} class="display-jp text-xl sm:text-2xl w-fit group-hover:text-accent transition-colors">{latest.data.title}</h2>
          {latest.data.description && <p class="mt-2 text-base text-ink-2 max-w-[36rem]">{latest.data.description}</p>}
          <div class="mt-4 flex flex-wrap gap-2">{latest.data.tags.map((t) => <span class="tag">#{t}</span>)}</div>
        </a>
      </div>
    )}

    {years.map((y) => (
      <section class="mb-8" data-year={y}>
        <h2 class="eyebrow mb-2"><span>{y}</span></h2>
        <PostList posts={rest.filter((p) => p.data.pubDate.getFullYear() === y)} />
      </section>
    ))}
    <div id="tag-empty" hidden={posts.length > 0}>
      <p class="text-sm text-muted">{posts.length === 0 ? 'まだ記事がありません。' : 'このタグの記事はありません。'}</p>
      {posts.length > 0 && <button id="tag-reset" type="button" class="chip glass press mt-4" aria-controls="blog-results">すべての記事を表示</button>}
    </div>
  </div>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const box = document.getElementById('tag-filter');
    const results = document.getElementById('blog-results');
    const status = document.getElementById('tag-status');
    const empty = document.getElementById('tag-empty');
    if (!box || !results || !status || !empty) return;

    const buttons = [...box.querySelectorAll<HTMLButtonElement>('button[data-tag]')];
    const items = [...results.querySelectorAll<HTMLElement>('[data-post]')].map((element) => ({
      element,
      tags: JSON.parse(element.dataset.tags ?? '[]') as string[],
    }));
    const groups = [...results.querySelectorAll<HTMLElement>('section[data-year]')].map((element) => ({
      element,
      items: [...element.querySelectorAll<HTMLElement>('[data-post]')],
    }));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let selectedTag = '';

    const selectTag = (tag: string, animate: boolean) => {
      if (tag === selectedTag) return;
      selectedTag = tag;
      const apply = () => {
        // 連続して選び直した場合、古い遷移で選択を戻さない。
        if (tag !== selectedTag) return;
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.tag === tag)));
        let count = 0;
        items.forEach(({ element, tags }) => {
          element.hidden = tag !== '' && !tags.includes(tag);
          if (!element.hidden) count++;
        });
        groups.forEach(({ element, items }) => {
          element.hidden = !items.some((item) => !item.hidden);
        });
        empty.hidden = count > 0;
        status.textContent = `${tag ? `#${tag} · ` : ''}${count} 件の記事`;
      };
      if (!animate || reducedMotion.matches || !document.startViewTransition ||
          !CSS.supports('selector(:active-view-transition-type(filter))')) {
        apply();
        return;
      }
      document.startViewTransition({ update: apply, types: ['filter'] });
    };

    box.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-tag]');
      if (!button || !box.contains(button)) return;
      selectTag(button.dataset.tag ?? '', event.detail > 0);
    });
    document.getElementById('tag-reset')?.addEventListener('click', (event) => {
      // リセット後に隠れるボタンから、残る「すべて」へフォーカスを戻す。
      buttons.find((button) => button.dataset.tag === '')?.focus({ preventScroll: true });
      selectTag('', event.detail > 0);
    });
  });
</script>
