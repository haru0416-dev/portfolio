---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import PostList from '../../components/PostList.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { readingMinutes } from '../../scripts/reading';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [latest, ...rest] = posts;
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const years = [...new Set(rest.map((p) => p.data.pubDate.getFullYear()))];
---
<Base title="Blog">
  <Hero eyebrow="Blog" title="Writing" lead="作りながら考えたことの記録。" />

  {latest && (
    <a href={`/blog/${latest.id}/`} class="card card-cover reveal block group mb-8">
      <div class="flex items-center gap-2 text-xs font-bold tracking-[.12em] uppercase text-accent-ink mb-2">
        <span>Latest</span><span class="text-muted">·</span>
        <FormattedDate date={latest.data.pubDate} class="text-muted" />
        <span class="text-muted">· {readingMinutes(latest.body)} min</span>
      </div>
      <h2 transition:name={`post-${latest.id}`} class="serif-jp text-xl sm:text-2xl w-fit group-hover:text-accent transition-colors">{latest.data.title}</h2>
      {latest.data.description && <p class="mt-2 text-base text-ink-2 max-w-[36rem]">{latest.data.description}</p>}
      <div class="mt-4 flex flex-wrap gap-2">{latest.data.tags.map((t) => <span class="tag">#{t}</span>)}</div>
    </a>
  )}

  {tags.length > 1 && (
    <search aria-label="タグで絞り込む">
      <div id="tag-filter" class="flex flex-wrap gap-2 mb-8">
        <button type="button" class="chip press" data-tag="" aria-pressed="true">すべて</button>
        {tags.map((t) => <button type="button" class="chip press" data-tag={t} aria-pressed="false">#{t}</button>)}
      </div>
      <p id="tag-status" class="sr-only" aria-live="polite"></p>
    </search>
  )}

  {rest.length > 0 && years.map((y) => (
    <section class="mb-8" data-year={y}>
      <h2 class="eyebrow mb-2"><span>{y}</span></h2>
      <PostList posts={rest.filter((p) => p.data.pubDate.getFullYear() === y)} />
    </section>
  ))}
  {rest.length === 0 && posts.length > 0 && <p class="text-sm text-muted">ほかの記事はまだありません。</p>}
  {posts.length === 0 && <p class="text-sm text-muted">まだ記事がありません。</p>}
</Base>

<script>
  // タグで絞り込む。最新カードは常に出す。ページ遷移のたびに付け直す
  document.addEventListener('astro:page-load', () => {
    const box = document.getElementById('tag-filter');
    const status = document.getElementById('tag-status');
    box?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-tag]');
      if (!btn) return;
      const tag = btn.dataset.tag ?? '';
      const apply = () => {
        box.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let n = 0;
        document.querySelectorAll<HTMLLIElement>('li[data-tags]').forEach((li) => {
          li.hidden = tag !== '' && !(li.dataset.tags ?? '').split(' ').includes(tag);
          if (!li.hidden) n++;
        });
        document.querySelectorAll<HTMLElement>('section[data-year]').forEach((sec) => {
          sec.hidden = ![...sec.querySelectorAll('li[data-tags]')].some((li) => !(li as HTMLLIElement).hidden);
        });
        if (status) status.textContent = `${n} 件の記事`;
      };
      // 残る項目が滑らかに詰まるよう、同一ページ内の遷移で包む(非対応ならそのまま)
      if (!document.startViewTransition) { apply(); return; }
      document.startViewTransition({ update: apply, types: ['filter'] });
    });
  });
</script>
