---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="mb-12">
      <div class="text-xs text-muted flex flex-wrap gap-x-4 mb-5 tracking-[.05em]">
        <FormattedDate date={post.data.pubDate} />
        {post.data.updatedDate && <span>updated <FormattedDate date={post.data.updatedDate} /></span>}
        {post.data.tags.map((t) => <span>#{t}</span>)}
      </div>
      <h1 class="serif-jp text-[2rem] sm:text-[2.4rem] leading-[1.35] tracking-tight">{post.data.title}</h1>
      {post.data.description && <p class="mt-4 text-ink-2 leading-relaxed">{post.data.description}</p>}
    </header>
    <div class="prose"><Content /></div>
  </article>

  {(older || newer) && <nav class="mt-20 pt-8 dotted grid sm:grid-cols-2 gap-6 text-sm">
    <div>
      {older && (
        <a href={`/blog/${older.id}/`} class="group block">
          <div class="text-[11px] tracking-[.12em] uppercase text-muted mb-1">← Older</div>
          <div class="serif-jp text-base group-hover:text-accent transition-colors">{older.data.title}</div>
        </a>
      )}
    </div>
    <div class="sm:text-right">
      {newer && (
        <a href={`/blog/${newer.id}/`} class="group block">
          <div class="text-[11px] tracking-[.12em] uppercase text-muted mb-1">Newer →</div>
          <div class="serif-jp text-base group-hover:text-accent transition-colors">{newer.data.title}</div>
        </a>
      )}
    </div>
  </nav>}
</Base>
