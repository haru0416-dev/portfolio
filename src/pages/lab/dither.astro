---
import Lab from '../../layouts/Lab.astro';
import { PALETTES } from '../../scripts/dither';
const groups = [
  { id: 'palette', label: 'パレット', items: Object.entries(PALETTES).map(([value, p]) => ({ value, label: p.label })), initial: 'violet' },
];
---
<Lab slug="dither">
  <div class="@container">
    <canvas id="dither" role="img" aria-label="惑星の縁と星空をディザで描いたアニメーション" class="w-full rounded-3xl golden bg-black pixelated"></canvas>
  </div>
  <div class="mt-4 flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
    <div class="flex flex-wrap gap-x-8 gap-y-4">
      {groups.map((g) => (
        <div role="group" aria-label={g.label} data-group={g.id} class="flex flex-wrap items-center gap-2">
          <span class="text-xs leading-4 tracking-[.08em] uppercase text-muted w-16">{g.label}</span>
          {g.items.map((it) => <button type="button" class="chip glass press" data-value={it.value} aria-pressed={it.value === g.initial ? "true" : "false"}>{it.label}</button>)}
        </div>
      ))}
    </div>
    <button type="button" id="dither-pause" class="chip glass press" aria-pressed="false">一時停止</button>
  </div>
  <p class="mt-8 text-sm text-ink-2 max-w-[44rem]">
    画面を 2px 単位に落として描き、各ピクセルの色に Bayer 2×2 の閾値行列のずれを足してから、パレットの中で最も近い色を選んでいます。すべて CPU の Canvas 2D で計算しています。
  </p>
</Lab>

<style>
  .pixelated { image-rendering: pixelated; }
</style>

<script>
  import { startDither, type DitherOptions } from '../../scripts/dither';
  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('dither') as HTMLCanvasElement | null;
    const pause = document.getElementById('dither-pause') as HTMLButtonElement | null;
    if (!canvas || !pause) return;
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
    const read = (): DitherOptions => {
      const pick = (id: string) => groups.find((g) => g.dataset.group === id)?.querySelector<HTMLButtonElement>('button[aria-pressed="true"]')?.dataset.value;
      return { palette: (pick('palette') ?? 'violet') as DitherOptions['palette'] };
    };
    const ctl = startDither(canvas, read());
    groups.forEach((g) => g.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-value]');
      if (!button) return;
      g.querySelectorAll('button[data-value]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      ctl.set(read());
    }));
    pause.addEventListener('click', () => {
      const paused = pause.getAttribute('aria-pressed') !== 'true';
      pause.setAttribute('aria-pressed', String(paused));
      pause.textContent = paused ? '再生' : '一時停止';
      paused ? ctl.pause() : ctl.resume();
    });
    document.addEventListener('astro:before-swap', () => ctl.dispose(), { once: true });
  });
</script>
