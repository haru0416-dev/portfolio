---
import Lab from '../../layouts/Lab.astro';
import { PALETTES } from '../../scripts/dither';
const palettes = Object.entries(PALETTES);
---
<Lab slug="dither">
  <div class="@container">
    <canvas id="dither" role="img" aria-label="惑星の縁と星空をディザで描いたアニメーション" class="w-full rounded-3xl golden bg-black pixelated"></canvas>
  </div>
  <div class="mt-4 flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
    <div role="group" aria-label="パレット" id="dither-palette" data-chip-group class="flex flex-wrap items-center gap-2">
      <span class="text-xs leading-4 tracking-[.08em] uppercase text-muted w-16">パレット</span>
      {palettes.map(([value, palette]) => <button type="button" class="chip glass press" data-value={value} aria-pressed={value === 'violet' ? 'true' : 'false'}>{palette.label}</button>)}
    </div>
    <button type="button" id="dither-pause" class="chip glass press" aria-pressed="false">一時停止</button>
  </div>
  <p class="mt-8 text-sm text-ink-2 max-w-[44rem]">
    画面を 2px 単位に粗くして描き、各ピクセルの色に Bayer 2×2 の閾値行列のずれを足してから、パレットの中でいちばん近い色を選んでいます。計算はぜんぶ CPU の Canvas 2D でやっています。
  </p>
</Lab>

<style>
  .pixelated { image-rendering: pixelated; }
</style>

<script>
  import { startDither, type PaletteName } from '../../scripts/dither';
  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('dither') as HTMLCanvasElement | null;
    const pause = document.getElementById('dither-pause') as HTMLButtonElement | null;
    const palette = document.getElementById('dither-palette');
    if (!canvas || !pause || !palette) return;
    const selected = palette.querySelector<HTMLButtonElement>('button[aria-pressed="true"]');
    if (!selected) return;
    const ctl = startDither(canvas, { palette: selected.dataset.value as PaletteName });
    palette.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-value]');
      if (!button || !palette.contains(button) || button.getAttribute('aria-pressed') === 'true') return;
      palette.querySelectorAll('button[data-value]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      ctl.set({ palette: button.dataset.value as PaletteName });
    });
    pause.addEventListener('click', () => {
      const paused = pause.getAttribute('aria-pressed') !== 'true';
      pause.setAttribute('aria-pressed', String(paused));
      pause.textContent = paused ? '再生' : '一時停止';
      paused ? ctl.pause() : ctl.resume();
    });
    document.addEventListener('astro:before-swap', () => ctl.dispose(), { once: true });
  });
</script>
