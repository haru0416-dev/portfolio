---
import Base from '../../layouts/Base.astro';
import { labBySlug } from '../../data/lab';
const meta = labBySlug('petals');
---
<Base title={meta.title} description={meta.description} wide jpHeadings={false}>
  <header class="mb-12">
    <a href="/lab/" class="u-link flex w-fit items-center min-h-6 text-xs tracking-[.08em] uppercase text-muted hover:text-ink mb-6">← Lab</a>
    <h1 transition:name={`lab-${meta.slug}`} class="vt-swap display w-fit text-2xl sm:text-3xl">{meta.title}</h1>
    <p class="mt-4 text-base text-ink-2 max-w-[36rem]">{meta.description}</p>
    <p class="mt-2 text-xs leading-4 tracking-[.08em] text-muted tabular-nums">{meta.date.replaceAll('-', '.')}</p>
  </header>
  <div class="@container">
    <canvas id="petals" role="img" aria-label="桜の花びらが風に乗って舞うアニメーション" class="w-full rounded-3xl petal-sky golden"></canvas>
  </div>
  <div class="mt-4 flex items-center justify-between gap-4">
    <p id="renderer" class="text-xs text-muted tracking-[.08em]"></p>
    <button type="button" id="petals-pause" class="chip glass press" aria-pressed="false">一時停止</button>
  </div>
  <p class="mt-8 text-sm text-muted">
    <a href="/blog/petals-webgpu/" class="u-link hover:text-ink inline-flex items-center min-h-6">制作記事「桜の花びらを WebGPU で描く」を読む →</a>
  </p>
</Base>

<script>
  import { startPetals, type PetalsControl } from '../../scripts/petals';
  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('petals') as HTMLCanvasElement | null;
    const label = document.getElementById('renderer');
    const pause = document.getElementById('petals-pause') as HTMLButtonElement | null;
    if (!canvas || !label || !pause) return;
    const gpuReady = ('gpu' in navigator) ? import('../../scripts/petals-gpu').then((m) => m.startPetalsGPU(canvas)) : Promise.resolve(null);
    gpuReady.then((gpu) => {
      let ctl: PetalsControl | null = gpu;
      if (gpu) { label.textContent = `WebGPU · ${gpu.count.toLocaleString()} petals`; }
      else {
        const c2 = canvas.cloneNode() as HTMLCanvasElement; // webgpu コンテキスト取得済みの canvas は 2d に戻せない
        canvas.replaceWith(c2);
        ctl = startPetals(c2);
        label.textContent = !window.isSecureContext
          ? 'Canvas 2D (WebGPU には HTTPS が必要)'
          : !('gpu' in navigator) ? 'Canvas 2D (このブラウザは WebGPU 未対応)' : 'Canvas 2D (GPU アダプタなし)';
      }
      pause.addEventListener('click', () => {
        const paused = pause.getAttribute('aria-pressed') !== 'true';
        pause.setAttribute('aria-pressed', String(paused));
        pause.textContent = paused ? '再生' : '一時停止';
        paused ? ctl?.pause() : ctl?.resume();
      });
      document.addEventListener('astro:before-swap', () => ctl?.dispose(), { once: true });
    });
  });
</script>
