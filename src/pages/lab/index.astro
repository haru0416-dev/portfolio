---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { LAB } from '../../data/lab';
---
<Base title="Lab" jpHeadings={false}>
  <Hero title="Lab" lead="ブラウザで動かせる実験を置いています。" />
  <ol role="list" class="divide-line">
    {LAB.map((l) => (
      <li class="reveal">
        <a href={`/lab/${l.slug}/`} class="group grid sm:grid-cols-[6rem_1fr] sm:items-baseline gap-x-4 gap-y-2 py-4">
          <span class="text-xs leading-4 text-muted tabular-nums">{l.date.replaceAll('-', '.')}</span>
          <div>
            <h2 transition:name={`lab-${l.slug}`} transition:animate="initial" class="vt-swap display w-fit text-lg leading-6 group-hover:text-accent-ink transition-colors">{l.title}</h2>
            <p class="phrase text-sm text-ink-2 mt-2">{l.description}</p>
          </div>
        </a>
      </li>
    ))}
  </ol>
</Base>
