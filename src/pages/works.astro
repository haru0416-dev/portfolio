---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Tile from '../components/Tile.astro';
import { ICONS } from '../data/icons';
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const badge = { active: '', wip: 'Work in progress', soon: 'Coming soon', archived: 'Archived' } as const;
const Code = ICONS.code, Ext = ICONS['external-link'];
---
<Base title="Works" wide>
  <Hero eyebrow="Works" title="Selected works" lead="代表的なものだけ。ほかは GitHub に。" />
  <ul role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {works.map((w, i) => (
      <li class="card reveal flex flex-col gap-4">
        <div class="flex items-center gap-4">
          <Tile icon={w.data.icon as any} size={48} class={`hue-${i % 3}`} />
          <div class="min-w-0 flex-1">
            <h2 class="serif-jp text-lg">{w.data.name}</h2>
            {badge[w.data.status] && <span class="block text-xs leading-4 font-bold tracking-[.1em] uppercase text-accent-ink">{badge[w.data.status]}</span>}
          </div>
        </div>
        <p class="text-sm text-ink-2 flex-1">{w.data.summary}</p>
        <div class="flex items-center gap-2">
          <div class="flex flex-wrap gap-2 flex-1">{w.data.stack.map((s) => <span class="tag">{s}</span>)}</div>
          {w.data.url && <a href={w.data.url} class="icon-btn icon-btn-accent press" aria-label={`${w.data.name} のサイトを開く`}><Ext size={14} stroke-width={2.5} aria-hidden="true" /></a>}
          {w.data.repo && w.data.status !== 'soon' && <a href={w.data.repo} class="icon-btn press" aria-label={`${w.data.name} のリポジトリを開く`}><Code size={14} stroke-width={2.5} aria-hidden="true" /></a>}
        </div>
      </li>
    ))}
  </ul>
</Base>
