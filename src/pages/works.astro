---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const badge = { active: '', wip: 'Work in progress', archived: 'Archived' } as const;
---
<Base title="Works" wide>
  <header class="mb-12 max-w-[42rem]">
    <p class="eyebrow mb-4"><span>Works</span></p>
    <h1 class="serif text-4xl">Selected works</h1>
    <p class="text-ink-2 mt-3">代表的なものだけ。ほかは GitHub に。</p>
  </header>
  <ol class="border-t border-line">
    {works.map((w, i) => (
      <li class="border-b border-line py-8 grid gap-6 sm:grid-cols-[3rem_4.5rem_1fr] items-start">
        <span class="hidden sm:block text-xs text-muted pt-1 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
        <Mark seed={w.id} size={64} class="rounded-sm" />
        <div>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h2 class="serif-jp text-[1.45rem] leading-snug">{w.data.name}</h2>
            {badge[w.data.status] && <span class="text-[11px] tracking-[.1em] uppercase text-accent">{badge[w.data.status]}</span>}
          </div>
          <p class="mt-3 text-ink-2 leading-relaxed max-w-[40rem]">{w.data.summary}</p>
          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
            <span class="text-xs text-muted tracking-[.05em]">{w.data.stack.join(' · ')}</span>
            {w.data.url && <a href={w.data.url} class="u-link text-accent">Site</a>}
            {w.data.repo && <a href={w.data.repo} class="u-link text-accent">Repository</a>}
          </div>
        </div>
      </li>
    ))}
  </ol>
</Base>
