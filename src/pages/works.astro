---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Tile from '../components/Tile.astro';
import { ICONS } from '../data/icons';
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const badge = { active: '', wip: 'Work in progress', archived: 'Archived' } as const;
const Code = ICONS.code, Ext = ICONS['external-link'];
---
<Base title="Works" wide>
  <Hero eyebrow="Works" title="Selected works" lead="代表的なものだけ。ほかは GitHub に。" pattern="dots" />
  <ul class="grid gap-5 sm:grid-cols-2">
    {works.map((w, i) => (
      <li class:list={['card flex flex-col gap-3', i === 0 && 'sm:col-span-2 sm:grid sm:grid-cols-[auto_1fr] sm:gap-6 sm:items-center']}>
        {i === 0
          ? <span class="hidden sm:block"><Tile icon={w.data.icon as any} size={112} class="hue-0" /></span>
          : <Tile icon={w.data.icon as any} size={48} class={`hue-${i % 3}`} />}
        <div class="flex flex-col gap-3 min-w-0">
          <div class="flex items-center gap-3">
            {i === 0 && <Tile icon={w.data.icon as any} size={48} class="hue-0 sm:hidden" />}
            <div class="min-w-0 flex-1">
              <h2 class:list={['serif-jp leading-snug', i === 0 ? 'text-[1.4rem] sm:text-[1.7rem]' : 'text-[1.15rem]']}>{w.data.name}</h2>
              {badge[w.data.status] && <span class="text-[10px] font-bold tracking-[.1em] uppercase text-accent">{badge[w.data.status]}</span>}
            </div>
            <div class="flex gap-1.5 shrink-0">
              {w.data.url && <a href={w.data.url} class="icon-btn icon-btn-accent press" aria-label="サイトを開く" title="Site"><Ext size={15} stroke-width={2.5} /></a>}
              {w.data.repo && <a href={w.data.repo} class="icon-btn press" aria-label="リポジトリを開く" title="Repository"><Code size={15} stroke-width={2.5} /></a>}
            </div>
          </div>
          <p class:list={['text-ink-2 leading-relaxed', i === 0 ? 'text-[1rem] max-w-[40rem]' : 'text-[.92rem]']}>{w.data.summary}</p>
          <div class="flex flex-wrap gap-1.5">{w.data.stack.map((s) => <span class="tag">{s}</span>)}</div>
        </div>
      </li>
    ))}
  </ul>
</Base>
