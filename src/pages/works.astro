---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const badge = { active: '', wip: 'WIP', archived: 'archived' } as const;
---
<Base title="Works" wide>
  <h1 class="text-2xl font-semibold tracking-tight mb-6">Works</h1>
  <ul class="grid gap-4 sm:grid-cols-2">
    {works.map((w) => (
      <li class="border border-line rounded-lg p-5 flex flex-col gap-2">
        <div class="flex items-baseline justify-between gap-2">
          <h2 class="font-medium">{w.data.name}</h2>
          {badge[w.data.status] && <span class="text-[10px] uppercase tracking-wider text-muted border border-line rounded px-1.5 py-0.5">{badge[w.data.status]}</span>}
        </div>
        <p class="text-sm text-muted flex-1">{w.data.summary}</p>
        <div class="text-xs text-muted flex flex-wrap gap-x-2">{w.data.stack.map((s) => <span>{s}</span>)}</div>
        <div class="text-sm flex gap-4 mt-1">
          {w.data.url && <a href={w.data.url} class="text-accent hover:underline">Site</a>}
          {w.data.repo && <a href={w.data.repo} class="text-accent hover:underline">Repo</a>}
        </div>
      </li>
    ))}
  </ul>
</Base>
