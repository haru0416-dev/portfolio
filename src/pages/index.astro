---
import { getPublishedPosts, getWorks } from '../data/collections';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import WorkCover from '../components/WorkCover.astro';
import Wordmark from '../components/Wordmark.astro';
import Avatar from '../components/Avatar.astro';
import { SITE } from '../site';
import { LAB } from '../data/lab';

const [allPosts, works] = await Promise.all([getPublishedPosts(), getWorks()]);
const posts = allPosts.slice(0, 5);
const lab = LAB.slice(0, 3);
const firstSentence = (s: string) => {
  const end = s.indexOf('。');
  return end === -1 ? s : s.slice(0, end + 1);
};
---
<Base wide>
  <section class="min-h-[round(down,calc(50dvh-4rem),8px)] lg:portrait:min-h-0 pb-12 lg:pb-[5.5rem] flex items-center">
    <div class="w-full lg:w-2/3 parallax">
      {/* モバイルではシールと見出しの間隔を保ち、段落の上に重ねて足元まで触れられるようにする。 */}
      <div class="relative">
        <div class="lg:hidden hero-lead absolute z-10 top-0 right-0 size-[min(9.5rem,calc(100vw-14.875rem))] sm:size-48">
          <Avatar sizes="(min-width: 40rem) 192px, 152px" />
        </div>
        <p class="eyebrow eyebrow-plain mb-6"><span>Notes &amp; experiments</span></p>
        <h1 class="display text-6xl sm:text-7xl tracking-[-0.01em]">
          <Wordmark text={SITE.name} /><span class="text-accent">.</span>
        </h1>
      </div>
      <p class="display-jp mt-6 text-base sm:text-xl text-ink hero-lead">
        作ったツールと開発メモ
      </p>
      <p class="mt-4 text-base text-ink-2 max-w-[32rem] hero-lead phrase">
        Rust や TypeScript でツールや対話プログラムを作っています。開発中に試したことや、ブラウザで動く実験も載せています。
      </p>
      <div class="mt-8 flex flex-wrap gap-2 hero-lead">
        <a href="/works/" class="pill pill-accent press">作品を見る</a>
        <a href="/blog/" class="pill glass press">記事を読む</a>
        <a href={SITE.github} class="pill glass press">GitHub</a>
      </div>
    </div>
    {/* 縦長の広い画面では見出しの最小高さを外し、下端に置く絵が本文から離れないようにする。絵は次の段の余白にはみ出す。 */}
    <div aria-hidden="true" class="hidden lg:flex lg:w-1/3 justify-end self-end -mb-8">
      <div class="hero-lead shrink-0 size-80">
        <Avatar sizes="320px" />
      </div>
    </div>
  </section>

  <div class="grid gap-x-12 gap-y-16 lg:grid-cols-[1fr_27rem] lg:grid-rows-[auto_1fr] pt-12">
    <section class="lg:col-start-1 lg:row-start-1">
      <h2 class="eyebrow mb-2"><span>Recent posts</span></h2>
      <PostList posts={posts} compact />
      <a href="/blog/" class="u-link inline-block mt-4 text-sm text-muted hover:text-ink">すべての記事 →</a>
    </section>

    <section class="reveal lg:col-start-2 lg:row-start-1 lg:row-span-2">
      <h2 class="eyebrow mb-2"><span>Works</span></h2>
      <ul role="list" class="space-y-4 pt-4">
        {works.map((w, i) => (
          <li>
            <a href={`/works/${w.id}/`} class="group flex gap-4 items-start">
              <span transition:name={`work-${w.id}`} transition:animate="initial" class="cover-thumb block mt-2"><WorkCover id={w.id} icon={w.data.icon} cover={w.data.cover} hue={i} iconSize={28} sizes="6rem" widths={[192, 384]} /></span>
              <div class="min-w-0">
                <div transition:name={`work-title-${w.id}`} transition:animate="initial" class="vt-swap display-jp w-fit text-base leading-6 group-hover:text-accent-ink transition-colors">{w.data.name}</div>
                <p class="phrase text-sm text-muted mt-2">{firstSentence(w.data.summary)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href="/works/" class="u-link inline-block mt-4 text-sm text-muted hover:text-ink">すべての作品 →</a>
    </section>

    <section class="reveal lg:col-start-1 lg:row-start-2">
      <h2 class="eyebrow mb-2"><span>Lab</span></h2>
      <ul role="list" class="space-y-4 pt-4">
        {lab.map((l) => (
          <li>
            <a href={`/lab/${l.slug}/`} class="group block">
              <div transition:name={`lab-${l.slug}`} transition:animate="initial" class="vt-swap display w-fit text-lg leading-6 group-hover:text-accent-ink transition-colors">{l.title}</div>
              <p class="phrase text-sm text-muted mt-2">{l.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
