---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Tile from '../components/Tile.astro';
import Wordmark from '../components/Wordmark.astro';
import { SITE } from '../site';
import { LAB } from '../data/lab';
import { SITE_ICON as SiteIcon } from '../data/icons';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const lab = LAB.slice(0, 3);
// 一覧では説明の最初の一文だけ出す(2 行で切ると文の途中で「…」になる)
const firstSentence = (s: string) => s.match(/^.*?。/)?.[0] ?? s;
---
<Base wide>
  <!-- 顔: 名前と一文だけ。画面の大半を余白にする -->
  <section class="min-h-[min(32rem,72dvh)] flex items-center gap-8">
    <div class="w-full max-w-[44rem] parallax">
      <p class="eyebrow eyebrow-plain mb-6"><span>Notes &amp; experiments</span></p>
      <h1 class="display text-6xl sm:text-7xl tracking-[-0.01em]">
        <Wordmark text={SITE.name} /><span class="text-accent">.</span>
      </h1>
      <p class="display-jp mt-6 text-base sm:text-xl text-ink hero-lead">
        作ったツールと開発メモ
      </p>
      <p class="mt-4 text-base text-ink-2 max-w-[32rem] hero-lead">
        Rust や TypeScript でツールや対話プログラムを作っています。開発中に試したことや、ブラウザで動く実験も載せています。
      </p>
      <div class="mt-8 flex flex-wrap gap-2 hero-lead">
        <a href="/works" class="pill pill-accent press">作品を見る</a>
        <a href="/blog" class="pill glass press">記事を読む</a>
        <a href={SITE.github} class="pill glass press">GitHub</a>
      </div>
    </div>
    <!-- 右の空きに、共有用画像(OG)と同じ芽の円を置く。広い画面だけ -->
    <div aria-hidden="true" class="hero-lead hidden lg:flex ml-auto shrink-0 size-60 rounded-full glass border border-line items-center justify-center text-accent">
      <SiteIcon size={112} stroke-width={1.75} />
    </div>
  </section>

  <!-- 広い画面では Works を右の列に通し、Lab を記事の下に回して左右の高さを揃える。狭い画面では記事・作品・Lab の順 -->
  <div class="grid gap-x-16 gap-y-16 lg:grid-cols-[1fr_20rem] lg:grid-rows-[auto_1fr] pt-16 dotted">
    <section class="lg:col-start-1 lg:row-start-1">
      <h2 class="eyebrow mb-2"><span>Recent posts</span></h2>
      <PostList posts={posts} compact />
      <a href="/blog" class="u-link inline-block mt-4 text-sm text-muted hover:text-ink">すべての記事 →</a>
    </section>

    <section class="reveal lg:col-start-2 lg:row-start-1 lg:row-span-2">
      <h2 class="eyebrow mb-4"><span>Works</span></h2>
      <ul role="list" class="space-y-4">
        {works.map((w) => (
          <li>
            <a href={w.data.status === 'soon' ? '/works' : (w.data.url ?? w.data.repo)} class="group flex gap-4 items-start">
              <Tile icon={w.data.icon as any} size={48} class="bg-paper-2" />
              <div class="min-w-0">
                <div class="text-base font-bold leading-6 group-hover:text-accent transition-colors">{w.data.name}</div>
                <p class="text-sm text-muted">{firstSentence(w.data.summary)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href="/works" class="u-link inline-block mt-4 text-sm text-muted hover:text-ink">すべての作品 →</a>
    </section>

    <section class="reveal lg:col-start-1 lg:row-start-2">
      <h2 class="eyebrow mb-4"><span>Lab</span></h2>
      <ul role="list" class="space-y-2">
        {lab.map((l) => (
          <li>
            <a href={`/lab/${l.slug}/`} class="group block">
              <div class="display text-lg group-hover:text-accent transition-colors">{l.title}</div>
              <p class="text-sm text-muted">{l.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
