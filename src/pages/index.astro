---
import { getPublishedPosts, getWorks } from '../data/collections';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import WorkCover from '../components/WorkCover.astro';
import Wordmark from '../components/Wordmark.astro';
import { SITE } from '../site';
import { LAB } from '../data/lab';
import { SITE_ICON as SiteIcon } from '../data/icons';

const posts = (await getPublishedPosts()).slice(0, 5);
const works = await getWorks();
const lab = LAB.slice(0, 3);
const firstSentence = (s: string) => s.match(/^.*?。/)?.[0] ?? s;
---
<Base wide>
  <section class="min-h-[round(down,calc(61.8dvh-7rem),8px)] pb-16 flex items-center">
    <div class="w-full lg:w-2/3 parallax">
      <p class="eyebrow eyebrow-plain mb-6"><span>Notes &amp; experiments</span></p>
      <h1 class="display text-6xl sm:text-7xl tracking-[-0.01em]">
        <Wordmark text={SITE.name} /><span class="text-accent">.</span>
      </h1>
      <p class="display-jp mt-6 text-base sm:text-xl text-ink hero-lead">
        作ったツールと開発メモ
      </p>
      <p class="mt-4 text-base text-ink-2 max-w-[32rem] hero-lead">
        Rust や TypeScript でツールや対話プログラムを作っています。開発中に試したことや、ブラウザで動く実験も載せています。
      </p>
      <div class="mt-8 flex flex-wrap gap-2 hero-lead">
        <a href="/works" class="pill pill-accent press">作品を見る</a>
        <a href="/blog" class="pill glass press">記事を読む</a>
        <a href={SITE.github} class="pill glass press">GitHub</a>
      </div>
    </div>
    <div aria-hidden="true" class="hidden lg:flex lg:w-1/3 justify-center">
      <div class="hero-lead flex shrink-0 size-60 rounded-full glass border border-line items-center justify-center text-accent">
        <SiteIcon size={112} stroke-width={1.75} />
      </div>
    </div>
  </section>

  <div class="grid gap-x-16 gap-y-16 lg:grid-cols-[1fr_21.5rem] lg:grid-rows-[auto_1fr] pt-16 dotted">
    <section class="lg:col-start-1 lg:row-start-1">
      <h2 class="eyebrow mb-2"><span>Recent posts</span></h2>
      <PostList posts={posts} compact />
      <a href="/blog" class="u-link inline-block mt-4 text-sm text-muted hover:text-ink">すべての記事 →</a>
    </section>

    <section class="reveal lg:col-start-2 lg:row-start-1 lg:row-span-2">
      <h2 class="eyebrow mb-4"><span>Works</span></h2>
      <ul role="list" class="space-y-4">
        {works.map((w, i) => (
          <li>
            <a href={`/works/${w.id}/`} class="group flex gap-4 items-start">
              <span transition:name={`work-${w.id}`} transition:animate="initial" class="cover-thumb block"><WorkCover icon={w.data.icon} cover={w.data.cover} hue={i} iconSize={28} sizes="6rem" widths={[192, 384]} /></span>
              <div class="min-w-0">
                <div transition:name={`work-title-${w.id}`} transition:animate="initial" class="vt-swap display-jp w-fit text-base leading-6 group-hover:text-accent-ink transition-colors">{w.data.name}</div>
                <p class="text-sm text-muted">{firstSentence(w.data.summary)}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <a href="/works" class="u-link inline-block mt-4 text-sm text-muted hover:text-ink">すべての作品 →</a>
    </section>

    <section class="reveal lg:col-start-1 lg:row-start-2">
      <h2 class="eyebrow mb-4"><span>Lab</span></h2>
      <ul role="list" class="space-y-2">
        {lab.map((l) => (
          <li>
            <a href={`/lab/${l.slug}/`} class="group block">
              <div transition:name={`lab-${l.slug}`} transition:animate="initial" class="vt-swap display w-fit text-lg group-hover:text-accent-ink transition-colors">{l.title}</div>
              <p class="text-sm text-muted">{l.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
