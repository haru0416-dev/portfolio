---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Mark from '../components/Mark.astro';
import Wordmark from '../components/Wordmark.astro';
import FlowMark from '../components/FlowMark.astro';
import { SITE } from '../site';
import { LAB } from '../data/lab';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const lab = LAB.slice(0, 3);
---
<Base wide>
  <!-- 顔: 名前と一文だけ。画面の大半を余白にする -->
  <section class="min-h-[calc(100dvh-4rem-6rem)] flex items-center -mt-12">
    <div class="w-full grid gap-12 sm:grid-cols-[minmax(0,1fr)_minmax(14rem,22rem)] items-center">
      <div>
        <p class="eyebrow mb-8"><span>Notes &amp; experiments</span></p>
        <h1 class="serif text-[4.5rem] sm:text-[7rem] leading-[0.95] tracking-[-0.02em]">
          <Wordmark text={SITE.name} /><span class="text-accent">.</span>
        </h1>
        <p class="serif-jp mt-8 text-[1.2rem] sm:text-[1.6rem] leading-[1.6] text-ink-2 max-w-[24em] hero-lead">
          作ったものと、作りながら考えたこと。
        </p>
      </div>
      <FlowMark class="hero-mark max-w-[16rem] sm:max-w-[22rem] justify-self-center sm:justify-self-end" />
    </div>
  </section>

  <div class="grid gap-x-16 gap-y-20 lg:grid-cols-[1fr_20rem] pt-24 border-t border-line">
    <section>
      <h2 class="eyebrow mb-2"><span>Recent posts</span></h2>
      <PostList posts={posts} />
      <a href="/blog" class="u-link inline-block mt-6 text-sm text-muted hover:text-ink">すべての記事 →</a>
    </section>

    <aside class="space-y-16">
      <section>
        <h2 class="eyebrow mb-5"><span>Works</span></h2>
        <ul class="space-y-5">
          {works.map((w) => (
            <li>
              <a href={w.data.url ?? w.data.repo} class="group flex gap-4 items-start">
                <Mark seed={w.id} size={44} class="shrink-0 rounded-sm" />
                <div>
                  <div class="font-medium group-hover:text-accent transition-colors">{w.data.name}</div>
                  <p class="text-[.85rem] text-muted leading-relaxed line-clamp-2">{w.data.summary}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a href="/works" class="u-link inline-block mt-5 text-sm text-muted hover:text-ink">すべての作品 →</a>
      </section>

      <section>
        <h2 class="eyebrow mb-5"><span>Lab</span></h2>
        <ul class="space-y-3">
          {lab.map((l) => (
            <li>
              <a href={`/lab/${l.slug}/`} class="group block">
                <div class="serif text-lg group-hover:text-accent transition-colors">{l.title}</div>
                <p class="text-[.85rem] text-muted leading-relaxed">{l.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</Base>
