---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site';
import { LAB } from '../data/lab';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const lab = LAB.slice(0, 3);
---
<Base>
  <section class="mb-14">
    <h1 class="text-3xl font-semibold tracking-tight">{SITE.name}</h1>
    <p class="mt-3 text-muted">{SITE.description}</p>
  </section>

  <section class="mb-14">
    <h2 class="text-sm font-medium text-muted mb-2 flex items-baseline justify-between">
      <span>Recent posts</span><a href="/blog" class="hover:text-accent">all →</a>
    </h2>
    <PostList posts={posts} />
  </section>

  <section class="mb-14">
    <h2 class="text-sm font-medium text-muted mb-3 flex items-baseline justify-between">
      <span>Works</span><a href="/works" class="hover:text-accent">all →</a>
    </h2>
    <ul class="space-y-3">
      {works.map((w) => (
        <li>
          <a href={w.data.url ?? w.data.repo} class="font-medium hover:text-accent">{w.data.name}</a>
          <p class="text-sm text-muted">{w.data.summary}</p>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="text-sm font-medium text-muted mb-3 flex items-baseline justify-between">
      <span>Lab</span><a href="/lab" class="hover:text-accent">all →</a>
    </h2>
    <ul class="space-y-2">
      {lab.map((l) => (
        <li><a href={`/lab/${l.slug}/`} class="hover:text-accent">{l.title}</a> <span class="text-sm text-muted">— {l.description}</span></li>
      ))}
    </ul>
  </section>
</Base>
