---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Mark from '../components/Mark.astro';
import { SITE } from '../site';
import { LAB } from '../data/lab';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const lab = LAB.slice(0, 3);
---
<Base wide>
  <section class="max-w-[42rem] mb-24 mt-6">
    <p class="eyebrow mb-6"><span>Notes &amp; experiments</span></p>
    <h1 class="serif-jp text-[1.9rem] sm:text-[2.9rem] leading-[1.35] tracking-tight">
      作ったものと、<br />作りながら考えたこと。
    </h1>
    <p class="mt-6 text-ink-2 leading-relaxed max-w-[34rem]">
      {SITE.name} の個人サイト。小さなツールや対話プログラムを Rust や TypeScript で作り、
      その過程で気づいたことを書き留めています。
    </p>
  </section>

  <div class="grid gap-x-16 gap-y-20 lg:grid-cols-[1fr_20rem]">
    <section>
      <h2 class="eyebrow mb-2"><span>Recent posts</span></h2>
      <PostList posts={posts} />
      <a href="/blog" class="u-link inline-block mt-6 text-sm text-muted hover:text-ink">すべての記事 →</a>
    </section>

    <aside class="space-y-16">
      <section>
        <h2 class="eyebrow mb-5"><span>Works</span></h2>
        <ul class="space-y-5">
          {works.map((w) => (
            <li>
              <a href={w.data.url ?? w.data.repo} class="group flex gap-4 items-start">
                <Mark seed={w.id} size={44} class="shrink-0 rounded-sm" />
                <div>
                  <div class="font-medium group-hover:text-accent transition-colors">{w.data.name}</div>
                  <p class="text-[.85rem] text-muted leading-relaxed line-clamp-2">{w.data.summary}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a href="/works" class="u-link inline-block mt-5 text-sm text-muted hover:text-ink">すべての作品 →</a>
      </section>

      <section>
        <h2 class="eyebrow mb-5"><span>Lab</span></h2>
        <ul class="space-y-3">
          {lab.map((l) => (
            <li>
              <a href={`/lab/${l.slug}/`} class="group block">
                <div class="serif text-lg group-hover:text-accent transition-colors">{l.title}</div>
                <p class="text-[.85rem] text-muted leading-relaxed">{l.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</Base>
