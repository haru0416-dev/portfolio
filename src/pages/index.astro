---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Tile from '../components/Tile.astro';
import Wordmark from '../components/Wordmark.astro';
import { SITE } from '../site';
import { LAB } from '../data/lab';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const lab = LAB.slice(0, 3);
---
<Base wide>
  <!-- 顔: 名前と一文だけ。画面の大半を余白にする -->
  <section class="min-h-[min(34rem,72dvh)] flex items-center -mt-4 sm:-mt-6">
    <div class="w-full max-w-[44rem]">
      <p class="eyebrow eyebrow-plain mb-6"><span>Notes &amp; experiments</span></p>
      <h1 class="serif text-[4.2rem] sm:text-[6.5rem] leading-[0.95] tracking-[-0.01em]">
        <Wordmark text={SITE.name} /><span class="text-accent">.</span>
      </h1>
      <p class="serif-jp mt-6 text-[1.1rem] sm:text-[1.5rem] leading-[1.6] text-ink hero-lead">
        作ったものと、作りながら考えたこと。
      </p>
      <p class="mt-4 text-ink-2 leading-relaxed max-w-[32rem] hero-lead">
        Rust や TypeScript で小さなツールや対話プログラムを作り、その過程で気づいたことを書き留めています。
      </p>
      <div class="mt-7 flex flex-wrap gap-2.5 hero-lead">
        <a href="/works" class="pill pill-accent press">作品を見る</a>
        <a href="/blog" class="pill press">記事を読む</a>
        <a href={SITE.github} class="pill press">GitHub</a>
      </div>
    </div>
  </section>

  <div class="grid gap-x-16 gap-y-20 lg:grid-cols-[1fr_20rem] pt-16 dotted">
    <section>
      <h2 class="eyebrow mb-2"><span>Recent posts</span></h2>
      <PostList posts={posts} />
      <a href="/blog" class="u-link inline-block mt-6 text-sm text-muted hover:text-ink">すべての記事 →</a>
    </section>

    <aside class="space-y-16">
      <section>
        <h2 class="eyebrow mb-5"><span>Works</span></h2>
        <ul class="space-y-5">
          {works.map((w) => (
            <li>
              <a href={w.data.url ?? w.data.repo} class="group flex gap-4 items-start">
                <Tile icon={w.data.icon as any} size={44} class="bg-paper-2" />
                <div>
                  <div class="font-medium group-hover:text-accent transition-colors">{w.data.name}</div>
                  <p class="text-[.85rem] text-muted leading-relaxed line-clamp-2">{w.data.summary}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a href="/works" class="u-link inline-block mt-5 text-sm text-muted hover:text-ink">すべての作品 →</a>
      </section>

      <section>
        <h2 class="eyebrow mb-5"><span>Lab</span></h2>
        <ul class="space-y-3">
          {lab.map((l) => (
            <li>
              <a href={`/lab/${l.slug}/`} class="group block">
                <div class="serif text-lg group-hover:text-accent transition-colors">{l.title}</div>
                <p class="text-[.85rem] text-muted leading-relaxed">{l.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</Base>
